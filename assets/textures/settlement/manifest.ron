    (name: "footing", width: 32, height: 32, repeat_m: 2.0),
    // `player-building` design B8: a player's door leaf, mapped once over
    // each face, drawn by tools/art/door_texture.py.
    (name: "door", width: 32, height: 64, repeat_m: 0.0),
    // `land-transport` design 12: the animals' coats, six 32 px tiles side
    // by side (hair, mane, hoof, feather, fleece, skin), each laid once round
    // a lofted part and repeated along it; drawn by tools/art/coat_texture.py.
    (name: "coat", width: 192, height: 32, repeat_m: 0.0),
    // `animal-husbandry` design 17 (the owner's pick, M26's blocky animals):
    // the herd's hides, a row each (horse, plodder, woolback, meadow hen) of
    // eight 32 px tiles (body, legs, head, horns, tail, mane, snout, ears),
    // laid by the metre on every face of a box; laid out by
    // tools/art/herd_hide.py from M26's hides.
    (name: "herd_hide", width: 256, height: 128, repeat_m: 0.0),
    // `townsfolk` design 26a (the fire and the anvil redone): the forge's
