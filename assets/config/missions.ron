        ),
        (
            id: "town",
            branch: "about",
            icon: "lights/lantern_post",
            needs: ["reef"],
            objectives: [
                (kind: reach, what: "town", count: 1),
            ],
        ),
        (
            id: "boat",
            branch: "about",
            icon: "goods/planks",
            needs: ["town"],
            objectives: [
                (kind: board, what: "boat", count: 1),
                (kind: travel, what: "boat", count: 100),
            ],
        ),
    ],
)
