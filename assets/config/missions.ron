        ),
        (
            id: "bronze-tool",
            branch: "mining",
            icon: "tools/bronze-pickaxe",
            needs: ["smelt"],
            objectives: [
                (kind: craft, what: "recipe:bronze-pickaxe", count: 1),
                (kind: gather, what: "block:stone", count: 5),
            ],
            unlocks: ["iron-pickaxe"],
        ),
        (
            id: "iron",
            branch: "mining",
            icon: "tools/iron-pickaxe",
            needs: ["bronze-tool"],
            objectives: [
                (kind: smelt, what: "iron-ingot", count: 3),
                (kind: craft, what: "recipe:iron-pickaxe", count: 1),
