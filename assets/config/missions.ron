// The starter missions (pbd_core::missions, `starter-missions` design 7-17
// and "Missions are a tree that unlocks the tech"): a trunk from bare hands
// to stone tools, then branches - fishing, farming, herding, mining and
// smelting, light and building - and cooking once there is food.
//
// A mission opens when every mission in `needs` is done (or pending), and is
// done when every objective's count is reached. Counts start when a mission
// opens; `craft` of a tool owned or an item carried, and `place` of a block
// the world's edits hold, are met by what the world already has.
//
// `unlocks` lists the recipe codes a mission's completion opens. A recipe a
// mission names is locked until then (the pack, the bench, the forge and the
// campfire all ask `Chain::recipe_open`); a recipe no mission names is open
// from the start; a recipe whose output the world already holds stays open,
// so a world from before the tree keeps every tool it could make.
//
// `what` is a name, names joined by `|` (any counts), `any`, or a group:
// `seed`, `crop` (produce), `ingot`, `fish`. Names are the recipe table's:
// a good's code, `block:<name>`, `tool:<name>`, `recipe:<code>`; animals
// and fish by their roster name in lower case. `fell` counts the axe's
// last log from a tree, `eat` a dish eaten, `night` the clock passing 20:00
// near a light in the world. `species` counts each kind of fish once in a
// mission, `baited` a fish landed on bait, `reach marked` the walker at
// the map's mark when it was set 200 m or more away.
//
// A craft of `recipe:<code>` counts the makes at a station, one a job, and
// is never met by what the world carries (a world from before the tree may
// carry the fences, gates and torches the old starting kit dealt).
//
// `awaited` names what another branch will bring: a mission naming only
// these where it names anything unknown is PENDING - logged at load, shown
// as not in this build, and met for the missions that need it. Any other
// unknown name is an error.
//
// A mission's `id` is saved in the world's `missions` record: append-only,
// never renamed. The old line's ids keep their place in the tree; an id the
// tree dropped (`metal-tool`) stays in an old world's record, unread.
//
(
    awaited: [],
    missions: [
        // ---- 0. The trunk: hands to tools, and a fire.
        (
            id: "gather",
            branch: "trunk",
            icon: "tools/hand",
            title: "Gather by hand",
            help: "Pick up loose stones and pull fiber from shrubs and ferns with F, and dig soft ground with bare hands for soil.",
            objectives: [
                (kind: gather, what: "fibre", count: 8, label: "Pull fiber"),
                (kind: gather, what: "stone", count: 9, label: "Pick up stones"),
                (kind: gather, what: "block:dirt|block:grass|block:dry grass|block:jungle grass|block:soil|block:sand", count: 6, label: "Dig soil"),
            ],
            unlocks: ["stone-axe"],
        ),
        (
            id: "axe",
            branch: "trunk",
            icon: "tools/stone-axe",
            title: "Craft an axe",
            help: "Pull a branch from a tree by hand, then make a stone axe in the pack's Craft row (I).",
            needs: ["gather"],
            objectives: [
                (kind: craft, what: "tool:axe|recipe:stone-axe", count: 1, label: "Make a stone axe"),
            ],
        ),
        (
            id: "wood",
            branch: "trunk",
            icon: "goods/log",
            title: "Gather wood",
            help: "Hold G and pick the axe with the wheel, then strike a trunk until the tree falls.",
            needs: ["axe"],
            objectives: [
                (kind: fell, what: "tree", count: 2, label: "Fell trees"),
                (kind: gather, what: "log", count: 10, label: "Gather logs"),
            ],
            unlocks: ["planks", "rope"],
        ),
        (
            id: "planks-rope",
            branch: "trunk",
            icon: "goods/rope",
            title: "Planks and rope",
            help: "In the pack (I), the Craft row makes planks from a log and rope from three fiber.",
            needs: ["wood"],
            objectives: [
                (kind: craft, what: "planks", count: 8, label: "Saw planks"),
                (kind: craft, what: "rope", count: 2, label: "Twist rope"),
            ],
            unlocks: ["workbench"],
        ),
        (
            id: "crafting-table",
            branch: "trunk",
            icon: "stations/workbench",
            title: "Build a crafting bench",
            help: "Make a workbench from six planks in the Craft row, then place it on the ground.",
            needs: ["planks-rope"],
            objectives: [
                (kind: craft, what: "block:workbench", count: 1, label: "Make a workbench"),
                (kind: place, what: "block:workbench", count: 1, label: "Set it down"),
            ],
            unlocks: ["stone-pickaxe", "stone-shovel", "rod"],
        ),
        (
            id: "stone-tools",
            branch: "trunk",
            icon: "tools/stone-pickaxe",
            title: "Stone tools",
            help: "At the workbench (F), make a stone pickaxe and a stone shovel.",
            needs: ["crafting-table"],
            objectives: [
                (kind: craft, what: "tool:pickaxe|recipe:stone-pickaxe", count: 1, label: "Make a stone pickaxe"),
                (kind: craft, what: "tool:shovel|recipe:stone-shovel", count: 1, label: "Make a stone shovel"),
            ],
        ),
        (
            id: "fire",
            branch: "trunk",
            icon: "lights/campfire",
            title: "Make a fire",
            help: "Make a campfire in the Craft row from five loose stone and two logs, and set it down near water.",
            needs: ["stone-tools"],
            objectives: [
                (kind: craft, what: "block:campfire|recipe:campfire", count: 1, label: "Make a campfire"),
                (kind: place, what: "block:campfire", count: 1, label: "Set it down"),
            ],
            unlocks: ["grilled-fish", "chili-fish", "flatbread", "roast-turnip", "kale-skewer", "fried-egg"],
        ),
        // ---- 1. Fishing.
        (
            id: "rod",
            branch: "fishing",
            icon: "tools/rod",
            title: "Make a fishing rod",
            help: "Make a rod at the workbench from planks, rope and fiber.",
            needs: ["fire"],
            objectives: [
                (kind: craft, what: "tool:rod|recipe:rod", count: 1, label: "Make a fishing rod"),
            ],
        ),
        (
            id: "go-fishing",
            branch: "fishing",
            icon: "fish/perch",
            title: "Go fishing",
            help: "Hold the rod (G), hold the left button and let go to cast. When the float goes under, click and reel.",
            needs: ["rod"],
            objectives: [
                (kind: cast, what: "water", count: 1, label: "Cast into water"),
                (kind: catch, what: "fish", count: 3, label: "Catch fish"),
            ],
            unlocks: ["bucket"],
        ),
        (
            id: "bait",
            branch: "fishing",
            icon: "tools/stone-shovel",
            title: "Dig for bait",
            help: "Dig wet ground at the water's edge for bait worms; cast with them in your pack and they go on the hook.",
            needs: ["go-fishing"],
            objectives: [
                (kind: gather, what: "bait", count: 3, label: "Dig up bait"),
                (kind: baited, what: "any", count: 3, label: "Catch fish on bait"),
            ],
        ),
        (
            id: "three-kinds",
            branch: "fishing",
            icon: "fish/silverfin",
            title: "Three kinds of fish",
            help: "Fish in other water and at other hours; the field guide (J) fills in each new kind.",
            needs: ["bait"],
            objectives: [
                (kind: species, what: "any", count: 3, label: "Catch different kinds"),
            ],
        ),
        (
            id: "sea-fishing",
            branch: "fishing",
            icon: "fish/eel",
            title: "Off the shore",
            help: "Cast from the shore into the sea, then from a river bank or a lake.",
            needs: ["three-kinds"],
            objectives: [
                (kind: waters, what: "sea", count: 3, label: "Fish the sea"),
                (kind: waters, what: "fresh", count: 3, label: "Fish a river or lake"),
            ],
        ),
        (
            id: "cook-fish",
            branch: "cooking",
            icon: "goods/grilled-fish",
            title: "Cook fish",
            help: "Open the campfire with F and grill the fish you caught.",
            needs: ["go-fishing"],
            objectives: [
                (kind: cook, what: "grilled-fish|chili-fish", count: 2, label: "Grill fish"),
            ],
        ),
        (
            id: "eat",
            branch: "cooking",
            icon: "goods/kale-skewer",
            title: "Eat well",
            help: "Put a dish on the hotbar and use it; its effect shows by the hotbar.",
            needs: ["cook-fish"],
            objectives: [
                (kind: eat, what: "grilled-fish|chili-fish|flatbread|roast-turnip|kale-skewer|fried-egg", count: 1, label: "Eat a cooked dish"),
            ],
        ),
        // ---- 2. Farming.
        (
            id: "find-seeds",
            branch: "farming",
            icon: "goods/chili-seed",
            title: "Find seeds",
            help: "Seeds turn up when you dig grass, and wild plants give them when picked (F).",
            needs: ["fire"],
            objectives: [
                (kind: find, what: "seed", count: 10, label: "Find seeds"),
            ],
        ),
        (
            id: "till",
            branch: "farming",
            icon: "tools/stone-shovel",
            title: "Break ground",
            help: "Hold G and pick the shovel with the wheel, then F tills soil.",
            needs: ["find-seeds"],
            objectives: [
                (kind: till, what: "any", count: 6, label: "Till soil"),
            ],
        ),
        (
            id: "plant",
            branch: "farming",
            icon: "goods/wheat-seed",
            title: "Plant a field",
            help: "Plant wheat seed on tilled soil with the right button.",
            needs: ["till"],
            objectives: [
                (kind: plant, what: "wheat-seed", count: 6, label: "Plant wheat seeds"),
            ],
        ),
        (
            id: "water-field",
            branch: "farming",
            icon: "goods/water-bucket",
            title: "Water the field",
            help: "Fill the bucket at water (right click), then pour it beside the field.",
            needs: ["plant"],
            after: ["go-fishing"],
            objectives: [
                (kind: pour, what: "water", count: 1, label: "Pour water on the field"),
            ],
        ),
        (
            id: "harvest",
            branch: "farming",
            icon: "goods/wheat",
            title: "Harvest",
            help: "A crop is ripe when it is full grown: F on it harvests produce and seed.",
            needs: ["water-field"],
            objectives: [
                (kind: harvest, what: "wheat", count: 6, label: "Harvest wheat"),
            ],
        ),
        (
            id: "three-crops",
            branch: "farming",
            icon: "goods/turnip",
            title: "A mixed field",
            help: "Turnip and chili seeds come with the first harvest; frost kale grows where it is cold.",
            needs: ["harvest"],
            objectives: [
                (kind: harvest, what: "turnip", count: 3, label: "Harvest turnips"),
                (kind: harvest, what: "chili", count: 3, label: "Harvest chilies"),
                (kind: harvest, what: "frost-kale", count: 3, label: "Harvest frost kale"),
            ],
        ),
        (
            id: "bread",
            branch: "farming",
            icon: "goods/flatbread",
            title: "Bake bread",
            help: "At the campfire, bake flatbread from wheat you grew.",
            needs: ["harvest"],
            objectives: [
                (kind: cook, what: "flatbread", count: 2, label: "Bake flatbread"),
            ],
        ),
        (
            id: "farm-meal",
            branch: "farming",
            icon: "goods/roast-turnip",
            title: "A farm meal",
            help: "At the campfire, cook a dish from your field.",
            needs: ["three-crops"],
            objectives: [
                (kind: cook, what: "roast-turnip|kale-skewer|chili-fish", count: 1, label: "Cook a farm dish"),
            ],
        ),
        (
            id: "feast",
            branch: "farming",
            icon: "goods/chili-fish",
            title: "A feast",
            help: "Eat three dishes: one from the sea, one from the field and one from the coop.",
            needs: ["farm-meal"],
            objectives: [
                (kind: eat, what: "grilled-fish|chili-fish", count: 1, label: "Eat from the sea"),
                (kind: eat, what: "flatbread|roast-turnip|kale-skewer", count: 1, label: "Eat from the field"),
                (kind: eat, what: "fried-egg", count: 1, label: "Eat from the coop"),
            ],
        ),
        // ---- 3. Herding.
        (
            id: "fence",
            branch: "herding",
            icon: "goods/fence",
            title: "Make fences",
            help: "At the workbench, make fences and a gate from planks and rope.",
            needs: ["fire"],
            objectives: [
                (kind: craft, what: "recipe:fence", count: 6, label: "Make fences"),
                (kind: craft, what: "recipe:gate", count: 1, label: "Make a gate"),
            ],
        ),
        (
            id: "tame",
            branch: "herding",
            icon: "missions/yard-hen",
            title: "Tame an animal",
            help: "Stand still with its food in hand and let a wild animal come to you, then feed it.",
            needs: ["fence"],
            objectives: [
                (kind: tame, what: "yard hen", count: 1, label: "Tame a hen"),
            ],
        ),
        (
            id: "pen",
            branch: "herding",
            icon: "goods/gate",
            title: "Build a pen",
            help: "Set fences on the cell edges round a yard, close it with a gate, and lead your animal in.",
            needs: ["tame"],
            objectives: [
                (kind: build_pen, what: "any", count: 1, label: "Build a pen with a gate"),
                (kind: pen, what: "any", count: 1, label: "Pen a tamed animal"),
            ],
        ),
        (
            id: "collect",
            branch: "herding",
            icon: "goods/egg",
            title: "Collect from the herd",
            help: "A kept animal in a pen gives an egg, wool or milk once a day: F on it collects.",
            needs: ["pen"],
            objectives: [
                (kind: collect, what: "egg", count: 5, label: "Collect eggs"),
            ],
        ),
        (
            id: "flock",
            branch: "herding",
            icon: "goods/wool",
            title: "A mixed herd",
            help: "Woolbacks and plodders graze in open country; tame one as you did the hen.",
            needs: ["collect"],
            objectives: [
                (kind: tame, what: "woolback|plodder", count: 1, label: "Tame a woolback or plodder"),
                (kind: collect, what: "wool|milk", count: 3, label: "Collect wool or milk"),
            ],
        ),
        (
            id: "fried-egg",
            branch: "herding",
            icon: "goods/fried-egg",
            title: "Breakfast",
            help: "At the campfire, fry an egg from your own hens.",
            needs: ["collect"],
            objectives: [
                (kind: cook, what: "fried-egg", count: 1, label: "Fry an egg"),
            ],
        ),
        // ---- 4. Mining and smelting.
        (
            id: "dig-deep",
            branch: "mining",
            icon: "goods/stone",
            title: "Dig into the hill",
            help: "Hold the stone pickaxe and dig into a hillside; stone comes out a cell at a time.",
            needs: ["fire"],
            objectives: [
                (kind: gather, what: "block:stone", count: 10, label: "Dig stone"),
            ],
            unlocks: ["forge"],
        ),
        (
            id: "ore",
            branch: "mining",
            icon: "goods/tin-ore",
            title: "Find ore",
            help: "Copper and tin show in the rock as mixed ore; coal sits in dark seams.",
            needs: ["dig-deep"],
            objectives: [
                (kind: gather, what: "block:ore", count: 4, label: "Dig ore"),
                (kind: gather, what: "coal", count: 3, label: "Dig coal"),
            ],
        ),
        (
            id: "forge",
            branch: "mining",
            icon: "stations/forge",
            title: "Build a forge",
            help: "Make a forge at the workbench and place it on the ground.",
            needs: ["ore"],
            objectives: [
                (kind: craft, what: "block:forge", count: 1, label: "Make a forge"),
                (kind: place, what: "block:forge", count: 1, label: "Set it down"),
            ],
            unlocks: ["mixed-ore", "bronze"],
        ),
        (
            id: "smelt",
            branch: "mining",
            icon: "goods/bronze-ingot",
            title: "Smelt bronze",
            help: "Put ore and coal in the forge (F) and smelt bronze.",
            needs: ["forge"],
            objectives: [
                (kind: smelt, what: "bronze-ingot", count: 2, label: "Smelt bronze ingots"),
            ],
            unlocks: ["bronze-pickaxe", "bronze-shovel", "bronze-axe"],
        ),
        (
            id: "bronze-tool",
            branch: "mining",
            icon: "tools/bronze-pickaxe",
            title: "Bronze tools",
            help: "At the workbench, make a bronze pickaxe from ingots; it digs faster than stone.",
            needs: ["smelt"],
            objectives: [
                (kind: craft, what: "recipe:bronze-pickaxe", count: 1, label: "Make a bronze pickaxe"),
                (kind: gather, what: "block:stone", count: 5, label: "Dig stone"),
            ],
            unlocks: ["iron-pickaxe"],
        ),
        (
            id: "iron",
            branch: "mining",
            icon: "tools/iron-pickaxe",
            title: "The iron age",
            help: "Iron ore smelts hotter: feed the forge more coal.",
            needs: ["bronze-tool"],
            objectives: [
                (kind: smelt, what: "iron-ingot", count: 3, label: "Smelt iron ingots"),
                (kind: craft, what: "recipe:iron-pickaxe", count: 1, label: "Make an iron pickaxe"),
            ],
            unlocks: ["iron-axe", "iron-shovel"],
        ),
        // ---- 6. Light and building.
        (
            id: "build",
            branch: "light",
            icon: "goods/stone",
            title: "Build a shelter",
            help: "Hold planks, stone or soil and place blocks with the right button: walls and a roof.",
            needs: ["fire"],
            objectives: [
                (kind: place, what: "any", count: 20, label: "Place blocks"),
            ],
            unlocks: ["torch"],
        ),
        (
            id: "torch",
            branch: "light",
            icon: "lights/torch",
            title: "Light the night",
            help: "Set torches round your shelter and stay by them as night falls.",
            needs: ["build"],
            objectives: [
                (kind: craft, what: "recipe:torch", count: 2, label: "Make torches"),
                (kind: place, what: "block:torch", count: 4, label: "Place torches"),
                (kind: night, what: "light", count: 1, label: "Stay by them at nightfall"),
            ],
        ),
        // ---- 7. Getting about.
        (
            id: "map",
            branch: "about",
            icon: "missions/map",
            title: "Read the map",
            help: "Open the map (M), right-click a place at least 200 m away to mark it, and walk there.",
            needs: ["go-fishing"],
            objectives: [
                (kind: open, what: "map", count: 1, label: "Open the map (M)"),
                (kind: reach, what: "marked", count: 1, label: "Reach a waypoint"),
            ],
        ),
        (
            id: "swim",
            branch: "about",
            icon: "water_life/sea_otter",
            title: "Into the water",
            help: "Walk into deep water and swim.",
            needs: ["map"],
            objectives: [
                (kind: swim, what: "water", count: 20, label: "Swim"),
            ],
        ),
        (
            id: "reef",
            branch: "about",
            icon: "fish/reef",
            title: "See a reef",
            help: "Swim down where the sea is warm and shallow.",
            needs: ["swim"],
            objectives: [
                (kind: reach, what: "reef", count: 1, label: "Reach a reef"),
            ],
        ),
        (
            id: "town",
            branch: "about",
            icon: "lights/lantern_post",
            title: "Find a town",
            help: "Towns show on the map; follow the compass to one.",
            needs: ["reef"],
            objectives: [
                (kind: reach, what: "town", count: 1, label: "Reach a town"),
            ],
        ),
        (
            id: "boat",
            branch: "about",
            icon: "goods/planks",
            title: "Take a boat",
            help: "Board a rowboat or a cog at a town's quay (F) and head out.",
            needs: ["town"],
            objectives: [
                (kind: board, what: "boat", count: 1, label: "Board a boat"),
                (kind: travel, what: "boat", count: 100, label: "Travel by boat"),
            ],
        ),
    ],
)
