// The starter missions (pbd_core::missions, `starter-missions` design 7-17
// and "Missions are a tree that unlocks the tech"): a trunk from bare hands
// to stone tools, then branches - fishing, farming, herding, mining and
// smelting, light and building - and cooking once there is food.
//
// A mission opens when every mission in `needs` is done (or pending), and is
// done when every objective's count is reached. Counts start when a mission
// opens; `craft` of a tool owned or an item carried, and `place` of a block
// the world's edits hold, are met by what the world already has.
//
// `unlocks` lists the recipe codes a mission's completion opens. A recipe a
// mission names is locked until then (the pack, the bench, the forge and the
// campfire all ask `Chain::recipe_open`); a recipe no mission names is open
// from the start; a recipe whose output the world already holds stays open,
// so a world from before the tree keeps every tool it could make.
//
// `what` is a name, names joined by `|` (any counts), `any`, or a group:
// `seed`, `crop` (produce), `ingot`, `fish`. Names are the recipe table's:
// a good's code, `block:<name>`, `tool:<name>`, `recipe:<code>`; animals
// and fish by their roster name in lower case. `fell` counts the axe's
// last log from a tree, `eat` a dish eaten, `night` the clock passing 20:00
// near a light in the world. `species` counts each kind of fish once in a
// mission, `baited` a fish landed on bait, `reach marked` the walker at
// the map's mark when it was set 200 m or more away.
//
// A craft of `recipe:<code>` counts the makes at a station, one a job, and
// is never met by what the world carries (a world from before the tree may
// carry the fences, gates and torches the old starting kit dealt).
//
// `awaited` names what another branch will bring: a mission naming only
// these where it names anything unknown is PENDING - logged at load, shown
// as not in this build, and met for the missions that need it. Any other
// unknown name is an error.
//
// A mission's `id` is saved in the world's `missions` record: append-only,
// never renamed. The old line's ids keep their place in the tree; an id the
// tree dropped (`metal-tool`) stays in an old world's record, unread.
//
(
    awaited: [],
    missions: [
        // ---- 0. The trunk: hands to tools, and a fire.
        (
            id: "gather",
            branch: "trunk",
            icon: "tools/hand",
            objectives: [
                (kind: gather, what: "fibre", count: 8),
                (kind: gather, what: "stone", count: 9),
                (kind: gather, what: "block:dirt|block:grass|block:dry grass|block:jungle grass|block:soil|block:sand", count: 6),
            ],
            unlocks: ["stone-axe"],
        ),
        // Then the pack, where what was gathered is crafted (owner,
        // 2026-11-22).
        (
            id: "pack",
            branch: "trunk",
            icon: "tools/hand",
            needs: ["gather"],
            objectives: [
                (kind: open, what: "pack", count: 1),
            ],
        ),
        (
            id: "axe",
            branch: "trunk",
            icon: "tools/stone-axe",
            needs: ["pack"],
            objectives: [
                (kind: craft, what: "tool:axe|recipe:stone-axe", count: 1),
            ],
        ),
        (
            id: "wood",
            branch: "trunk",
            icon: "goods/log",
            needs: ["axe"],
            objectives: [
                (kind: fell, what: "tree", count: 2),
                (kind: gather, what: "log", count: 10),
            ],
            unlocks: ["planks", "rope"],
        ),
        (
            id: "planks-rope",
            branch: "trunk",
            icon: "goods/rope",
            needs: ["wood"],
            objectives: [
                (kind: craft, what: "planks", count: 8),
                (kind: craft, what: "rope", count: 2),
            ],
            unlocks: ["workbench"],
        ),
        (
            id: "crafting-table",
            branch: "trunk",
            icon: "stations/workbench",
            needs: ["planks-rope"],
            objectives: [
                (kind: craft, what: "block:workbench", count: 1),
                (kind: place, what: "block:workbench", count: 1),
            ],
            unlocks: ["stone-pickaxe", "stone-shovel", "rod"],
        ),
        (
            id: "stone-tools",
            branch: "trunk",
            icon: "tools/stone-pickaxe",
            needs: ["crafting-table"],
            objectives: [
                (kind: craft, what: "tool:pickaxe|recipe:stone-pickaxe", count: 1),
                (kind: craft, what: "tool:shovel|recipe:stone-shovel", count: 1),
            ],
        ),
        (
            id: "fire",
            branch: "trunk",
            icon: "lights/campfire",
            needs: ["stone-tools"],
            objectives: [
                (kind: craft, what: "block:campfire|recipe:campfire", count: 1),
                (kind: place, what: "block:campfire", count: 1),
            ],
            unlocks: ["grilled-fish", "chili-fish", "flatbread", "roast-turnip", "kale-skewer", "fried-egg"],
        ),
        (
            id: "storage",
            branch: "trunk",
            icon: "stations/chest",
            needs: ["fire"],
            objectives: [
                (kind: craft, what: "block:chest|recipe:chest", count: 1),
                (kind: place, what: "block:chest", count: 1),
                (kind: store, what: "block:dirt|block:grass|block:dry grass|block:jungle grass|block:soil|block:sand|block:desert sand|block:stone|stone|log|planks|fibre", count: 1),
            ],
        ),
        // ---- 1. Fishing.
        (
            id: "rod",
            branch: "fishing",
            icon: "tools/rod",
            needs: ["fire"],
            objectives: [
                (kind: craft, what: "tool:rod|recipe:rod", count: 1),
            ],
        ),
        (
            id: "go-fishing",
            branch: "fishing",
            icon: "fish/perch",
            needs: ["rod"],
            objectives: [
                (kind: catch, what: "fish", count: 3),
            ],
            unlocks: ["bucket"],
        ),
        (
            id: "bait",
            branch: "fishing",
            icon: "tools/stone-shovel",
            needs: ["go-fishing"],
            objectives: [
                (kind: gather, what: "bait", count: 3),
                (kind: baited, what: "any", count: 3),
            ],
        ),
        (
            id: "three-kinds",
            branch: "fishing",
            icon: "fish/silverfin",
            needs: ["bait"],
            objectives: [
                (kind: species, what: "any", count: 3),
            ],
        ),
        (
            id: "sea-fishing",
            branch: "fishing",
            icon: "fish/eel",
            needs: ["three-kinds"],
            objectives: [
                (kind: waters, what: "sea", count: 3),
                (kind: waters, what: "fresh", count: 3),
            ],
        ),
        (
            id: "cook-fish",
            branch: "cooking",
            icon: "goods/grilled-fish",
            needs: ["go-fishing"],
            objectives: [
                (kind: cook, what: "grilled-fish|chili-fish", count: 2),
            ],
        ),
        (
            id: "eat",
            branch: "cooking",
            icon: "goods/kale-skewer",
            needs: ["cook-fish"],
            objectives: [
                (kind: eat, what: "grilled-fish|chili-fish|flatbread|roast-turnip|kale-skewer|fried-egg", count: 1),
            ],
        ),
        // ---- 2. Farming.
        (
            id: "find-seeds",
            branch: "farming",
            icon: "goods/chili-seed",
            needs: ["fire"],
            objectives: [
                (kind: find, what: "seed", count: 10),
            ],
        ),
        (
            id: "till",
            branch: "farming",
            icon: "tools/stone-shovel",
            needs: ["find-seeds"],
            objectives: [
                (kind: till, what: "any", count: 6),
            ],
        ),
        (
            id: "plant",
            branch: "farming",
            icon: "goods/wheat-seed",
            needs: ["till"],
            objectives: [
                (kind: plant, what: "wheat-seed", count: 6),
            ],
        ),
        (
            id: "water-field",
            branch: "farming",
            icon: "goods/water-bucket",
            needs: ["plant"],
            after: ["go-fishing"],
            objectives: [
                (kind: pour, what: "water", count: 1),
            ],
        ),
        (
            id: "harvest",
            branch: "farming",
            icon: "goods/wheat",
            needs: ["water-field"],
            objectives: [
                (kind: harvest, what: "wheat", count: 6),
            ],
        ),
        (
            id: "three-crops",
            branch: "farming",
            icon: "goods/turnip",
            needs: ["harvest"],
            objectives: [
                (kind: harvest, what: "turnip", count: 3),
                (kind: harvest, what: "chili", count: 3),
                (kind: harvest, what: "frost-kale", count: 3),
            ],
        ),
        (
            id: "bread",
            branch: "farming",
            icon: "goods/flatbread",
            needs: ["harvest"],
            objectives: [
                (kind: cook, what: "flatbread", count: 2),
            ],
        ),
        (
            id: "farm-meal",
            branch: "farming",
            icon: "goods/roast-turnip",
            needs: ["three-crops"],
            objectives: [
                (kind: cook, what: "roast-turnip|kale-skewer|chili-fish", count: 1),
            ],
        ),
        (
            id: "feast",
            branch: "farming",
            icon: "goods/chili-fish",
            needs: ["farm-meal"],
            objectives: [
                (kind: eat, what: "grilled-fish|chili-fish", count: 1),
                (kind: eat, what: "flatbread|roast-turnip|kale-skewer", count: 1),
                (kind: eat, what: "fried-egg", count: 1),
            ],
        ),
        // ---- 3. Herding.
        (
            id: "fence",
            branch: "herding",
            icon: "goods/fence",
            needs: ["fire"],
            objectives: [
                (kind: craft, what: "recipe:fence", count: 6),
                (kind: craft, what: "recipe:gate", count: 1),
            ],
        ),
        (
            id: "tame",
            branch: "herding",
            icon: "missions/yard-hen",
            needs: ["fence"],
            objectives: [
                (kind: tame, what: "yard hen", count: 1),
