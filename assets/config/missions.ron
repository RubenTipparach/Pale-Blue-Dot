        ),
        (
            id: "flock",
            branch: "herding",
            icon: "goods/wool",
            needs: ["collect"],
            objectives: [
                (kind: tame, what: "woolback|plodder", count: 1),
                (kind: collect, what: "wool|milk", count: 3),
            ],
        ),
        (
            id: "fried-egg",
            branch: "herding",
            icon: "goods/fried-egg",
            needs: ["collect"],
            objectives: [
                (kind: cook, what: "fried-egg", count: 1),
            ],
        ),
        // ---- 4. Mining and smelting.
        (
            id: "dig-deep",
            branch: "mining",
            icon: "goods/stone",
            needs: ["fire"],
            objectives: [
                (kind: gather, what: "block:stone", count: 10),
            ],
