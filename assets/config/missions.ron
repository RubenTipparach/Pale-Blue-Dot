// The starter missions (pbd_core::missions, `starter-missions` design 7-17
// and "Missions are a tree that unlocks the tech"): a trunk from bare hands
// to stone tools, then branches - fishing, farming, herding, mining and
// smelting, light and building - and cooking once there is food.
//
// A mission opens when every mission in `needs` is done (or pending), and is
// done when every objective's count is reached. Counts start when a mission
// opens; `craft` of a tool owned or an item carried, and `place` of a block
// the world's edits hold, are met by what the world already has.
//
// `unlocks` lists the recipe codes a mission's completion opens. A recipe a
// mission names is locked until then (the pack, the bench, the forge and the
// campfire all ask `Chain::recipe_open`); a recipe no mission names is open
// from the start; a recipe whose output the world already holds stays open,
// so a world from before the tree keeps every tool it could make.
//
// `what` is a name, names joined by `|` (any counts), `any`, or a group:
// `seed`, `crop` (produce), `ingot`, `fish`. Names are the recipe table's:
// a good's code, `block:<name>`, `tool:<name>`, `recipe:<code>`; animals
// and fish by their roster name in lower case. `fell` counts the axe's
// last log from a tree, `eat` a dish eaten, `night` the clock passing 20:00
// near a light in the world.
//
// A craft of `recipe:<code>` counts the makes at a station, one a job, and
// is never met by what the world carries (the starting kit deals fences,
// gates and torches to every world today).
//
// `awaited` names what another branch will bring: a mission naming only
// these where it names anything unknown is PENDING - logged at load, shown
// as not in this build, and met for the missions that need it. Any other
// unknown name is an error.
//
// A mission's `id` is saved in the world's `missions` record: append-only,
// never renamed. The old line's ids keep their place in the tree; an id the
// tree dropped (`metal-tool`) stays in an old world's record, unread.
//
(
    // Bait has no good yet: "Dig for bait" waits for it.
    awaited: ["bait"],
    missions: [
        // ---- 0. The trunk: hands to tools, and a fire.
        (
            id: "gather",
            branch: "trunk",
            title: "Gather by hand",
            help: "Dig soft ground with bare hands: fibre turns up in grass, loose stone in the soil under it.",
            objectives: [
                (kind: gather, what: "fibre", count: 4, label: "fibre"),
                (kind: gather, what: "stone", count: 4, label: "stone"),
                (kind: gather, what: "block:dirt|block:grass|block:soil|block:sand", count: 4, label: "soil"),
            ],
            unlocks: ["stone-axe"],
        ),
        (
            id: "axe",
            branch: "trunk",
            title: "Craft an axe",
            help: "Pull a branch from a tree by hand, then make a stone axe in the pack's Craft row (I).",
            needs: ["gather"],
            objectives: [
                (kind: craft, what: "tool:axe|recipe:stone-axe", count: 1, label: "axe"),
            ],
        ),
        (
            id: "wood",
            branch: "trunk",
            title: "Gather wood",
            help: "Hold the axe and strike a trunk until the tree falls.",
            needs: ["axe"],
            objectives: [
                (kind: fell, what: "tree", count: 2, label: "trees"),
                (kind: gather, what: "log", count: 10, label: "logs"),
            ],
            unlocks: ["planks", "rope"],
        ),
        (
            id: "planks-rope",
            branch: "trunk",
            title: "Planks and rope",
            help: "In the pack (I), the Craft row makes planks from a log and rope from three fibre.",
            needs: ["wood"],
            objectives: [
                (kind: craft, what: "planks", count: 8, label: "planks"),
                (kind: craft, what: "rope", count: 2, label: "rope"),
            ],
            unlocks: ["workbench"],
        ),
        (
            id: "crafting-table",
            branch: "trunk",
            title: "Build a crafting bench",
            help: "Make a workbench from six planks in the Craft row, then place it on the ground.",
            needs: ["planks-rope"],
            objectives: [
                (kind: craft, what: "block:workbench", count: 1, label: "make"),
                (kind: place, what: "block:workbench", count: 1, label: "place"),
            ],
            unlocks: ["stone-pickaxe", "stone-shovel", "rod"],
        ),
        (
            id: "stone-tools",
            branch: "trunk",
            title: "Stone tools",
            help: "At the workbench (E), make a stone pickaxe and a stone shovel.",
            needs: ["crafting-table"],
            objectives: [
                (kind: craft, what: "tool:pickaxe|recipe:stone-pickaxe", count: 1, label: "pickaxe"),
                (kind: craft, what: "tool:shovel|recipe:stone-shovel", count: 1, label: "shovel"),
            ],
        ),
        (
            id: "fire",
            branch: "trunk",
            title: "Make a fire",
            help: "Make a campfire in the Craft row from five loose stone and two logs, and set it down near water.",
            needs: ["stone-tools"],
            objectives: [
                (kind: craft, what: "block:campfire|recipe:campfire", count: 1, label: "make"),
                (kind: place, what: "block:campfire", count: 1, label: "place"),
            ],
            unlocks: ["grilled-fish", "chili-fish", "flatbread", "roast-turnip", "kale-skewer", "fried-egg"],
        ),
        // ---- 1. Fishing.
        (
            id: "rod",
            branch: "fishing",
            title: "Make a fishing rod",
            help: "Make a rod at the workbench from planks, rope and fibre.",
            needs: ["fire"],
            objectives: [
                (kind: craft, what: "tool:rod|recipe:rod", count: 1, label: "rod"),
            ],
        ),
        (
            id: "go-fishing",
            branch: "fishing",
            title: "Go fishing",
            help: "Hold the rod (G), hold the left button and let go to cast. When the float goes under, click and reel.",
            needs: ["rod"],
            objectives: [
                (kind: cast, what: "water", count: 1, label: "cast"),
                (kind: catch, what: "fish", count: 3, label: "fish"),
            ],
            unlocks: ["bucket"],
        ),
        (
            id: "bait",
            branch: "fishing",
            title: "Dig for bait",
            help: "Dig wet ground by the water for bait, and cast again with it on the hook.",
            needs: ["go-fishing"],
            objectives: [
                (kind: gather, what: "bait", count: 1, label: "dig bait"),
                (kind: catch, what: "bait", count: 1, label: "catch with bait"),
            ],
        ),
        (
            id: "three-kinds",
            branch: "fishing",
            title: "Three kinds of fish",
            help: "Fish in other water and at other hours; the field guide (J) fills in each new kind.",
            needs: ["bait"],
            objectives: [
                (kind: species, what: "any", count: 3, label: "species"),
            ],
        ),
        (
            id: "sea-fishing",
            branch: "fishing",
            title: "Off the shore",
            help: "Cast from the shore into the sea, then from a river bank or a lake.",
            needs: ["three-kinds"],
            objectives: [
                (kind: waters, what: "sea", count: 1, label: "the sea"),
                (kind: waters, what: "fresh", count: 1, label: "fresh water"),
            ],
        ),
        (
            id: "cook-fish",
            branch: "cooking",
            title: "Cook fish",
            help: "Open the campfire with E and grill the fish you caught.",
            needs: ["go-fishing"],
            objectives: [
                (kind: cook, what: "grilled-fish|chili-fish", count: 2, label: "fish"),
            ],
        ),
        (
            id: "eat",
            branch: "cooking",
            title: "Eat well",
            help: "Put a dish on the hotbar and use it; its effect shows by the hotbar.",
            needs: ["cook-fish"],
            objectives: [
                (kind: eat, what: "grilled-fish|chili-fish|flatbread|roast-turnip|kale-skewer|fried-egg", count: 1, label: "eat"),
            ],
        ),
        // ---- 2. Farming.
        (
            id: "find-seeds",
            branch: "farming",
            title: "Find seeds",
            help: "Seeds turn up when you dig grass, and wild plants give them when picked (E).",
            needs: ["fire"],
            objectives: [
                (kind: find, what: "seed", count: 2, label: "seeds"),
            ],
        ),
        (
            id: "till",
            branch: "farming",
            title: "Break ground",
            help: "With the shovel in hand, E tills soil.",
            needs: ["find-seeds"],
            objectives: [
                (kind: till, what: "any", count: 4, label: "till"),
            ],
        ),
        (
            id: "plant",
            branch: "farming",
            title: "Plant a field",
            help: "Plant wheat seed on tilled soil with the right button.",
            needs: ["till"],
            objectives: [
                (kind: plant, what: "wheat-seed", count: 4, label: "plant"),
            ],
        ),
        (
            id: "water-field",
            branch: "farming",
            title: "Water the field",
            help: "Fill the bucket at water (E), then pour it beside the field.",
            needs: ["plant"],
            after: ["go-fishing"],
            objectives: [
                (kind: pour, what: "water", count: 1, label: "pour"),
            ],
        ),
        (
            id: "harvest",
            branch: "farming",
            title: "Harvest",
            help: "A crop is ripe when it is full grown: E on it harvests produce and seed.",
            needs: ["water-field"],
            objectives: [
                (kind: harvest, what: "wheat", count: 4, label: "wheat"),
            ],
        ),
        (
            id: "three-crops",
            branch: "farming",
            title: "A mixed field",
            help: "Turnip and chili seeds come with the first harvest; frost kale grows where it is cold.",
            needs: ["harvest"],
            objectives: [
                (kind: harvest, what: "turnip", count: 1, label: "turnip"),
                (kind: harvest, what: "chili", count: 1, label: "chili"),
                (kind: harvest, what: "frost-kale", count: 1, label: "frost kale"),
            ],
        ),
        (
            id: "bread",
            branch: "farming",
            title: "Bake bread",
            help: "At the campfire, bake flatbread from wheat you grew.",
            needs: ["harvest"],
            objectives: [
                (kind: cook, what: "flatbread", count: 2, label: "flatbread"),
            ],
        ),
        (
            id: "farm-meal",
            branch: "farming",
            title: "A farm meal",
            help: "At the campfire, cook a dish from your field.",
            needs: ["three-crops"],
            objectives: [
                (kind: cook, what: "roast-turnip|kale-skewer|chili-fish", count: 1, label: "dish"),
            ],
        ),
        (
            id: "feast",
            branch: "farming",
            title: "A feast",
            help: "Eat three dishes: one from the sea, one from the field and one from the coop.",
            needs: ["farm-meal"],
            objectives: [
                (kind: eat, what: "grilled-fish|chili-fish", count: 1, label: "from the sea"),
                (kind: eat, what: "flatbread|roast-turnip|kale-skewer", count: 1, label: "from the field"),
                (kind: eat, what: "fried-egg", count: 1, label: "from the coop"),
            ],
        ),
        // ---- 3. Herding.
        (
            id: "fence",
            branch: "herding",
            title: "Make fences",
            help: "At the workbench, make fences and a gate from planks and rope.",
            needs: ["fire"],
            objectives: [
                (kind: craft, what: "recipe:fence", count: 6, label: "fences"),
                (kind: craft, what: "recipe:gate", count: 1, label: "gate"),
            ],
        ),
        (
            id: "tame",
            branch: "herding",
            title: "Tame an animal",
            help: "Stand still with its food in hand and let a wild animal come to you, then feed it.",
            needs: ["fence"],
            objectives: [
                (kind: tame, what: "yard hen", count: 1, label: "tame"),
            ],
        ),
        (
            id: "pen",
            branch: "herding",
            title: "Build a pen",
            help: "Set fences on the cell edges round a yard, close it with a gate, and lead your animal in.",
            needs: ["tame"],
            objectives: [
                (kind: build_pen, what: "any", count: 1, label: "build"),
                (kind: pen, what: "any", count: 1, label: "keep an animal"),
            ],
        ),
        (
            id: "collect",
            branch: "herding",
            title: "Collect from the herd",
            help: "A kept animal in a pen gives an egg, wool or milk once a day: E on it collects.",
            needs: ["pen"],
            objectives: [
                (kind: collect, what: "egg", count: 2, label: "eggs"),
            ],
        ),
        (
            id: "flock",
            branch: "herding",
            title: "A mixed herd",
            help: "Woolbacks and plodders graze in open country; tame one as you did the hen.",
            needs: ["collect"],
            objectives: [
                (kind: tame, what: "woolback|plodder", count: 1, label: "tame"),
                (kind: collect, what: "wool|milk", count: 1, label: "wool or milk"),
            ],
        ),
        (
            id: "fried-egg",
            branch: "herding",
            title: "Breakfast",
            help: "At the campfire, fry an egg from your own hens.",
            needs: ["collect"],
            objectives: [
                (kind: cook, what: "fried-egg", count: 1, label: "egg"),
            ],
        ),
        // ---- 4. Mining and smelting.
        (
            id: "dig-deep",
            branch: "mining",
            title: "Dig into the hill",
            help: "Hold the stone pickaxe and dig into a hillside; stone comes out a cell at a time.",
            needs: ["fire"],
            objectives: [
                (kind: gather, what: "block:stone", count: 10, label: "stone"),
            ],
            unlocks: ["forge"],
        ),
        (
            id: "ore",
            branch: "mining",
            title: "Find ore",
            help: "Copper and tin show in the rock as mixed ore; coal sits in dark seams.",
            needs: ["dig-deep"],
            objectives: [
                (kind: gather, what: "block:ore", count: 1, label: "ore"),
                (kind: gather, what: "coal", count: 1, label: "coal"),
            ],
        ),
        (
            id: "forge",
            branch: "mining",
            title: "Build a forge",
            help: "Make a forge at the workbench and place it on the ground.",
            needs: ["ore"],
            objectives: [
                (kind: craft, what: "block:forge", count: 1, label: "make"),
                (kind: place, what: "block:forge", count: 1, label: "place"),
            ],
            unlocks: ["mixed-ore", "bronze"],
        ),
        (
            id: "smelt",
            branch: "mining",
            title: "Smelt bronze",
            help: "Put ore and coal in the forge (E) and smelt bronze.",
            needs: ["forge"],
            objectives: [
                (kind: smelt, what: "bronze-ingot", count: 2, label: "bronze"),
            ],
            unlocks: ["bronze-pickaxe", "bronze-shovel", "bronze-axe"],
        ),
        (
            id: "bronze-tool",
            branch: "mining",
            title: "Bronze tools",
            help: "At the workbench, make a bronze pickaxe from ingots; it digs faster than stone.",
            needs: ["smelt"],
            objectives: [
                (kind: craft, what: "recipe:bronze-pickaxe", count: 1, label: "pickaxe"),
                (kind: gather, what: "block:stone", count: 5, label: "stone"),
            ],
            unlocks: ["iron-pickaxe"],
        ),
        (
            id: "iron",
            branch: "mining",
            title: "The iron age",
            help: "Iron ore smelts hotter: feed the forge more coal.",
            needs: ["bronze-tool"],
            objectives: [
                (kind: smelt, what: "iron-ingot", count: 1, label: "iron"),
                (kind: craft, what: "recipe:iron-pickaxe", count: 1, label: "pickaxe"),
            ],
            unlocks: ["iron-axe", "iron-shovel"],
        ),
        // ---- 6. Light and building.
        (
            id: "build",
            branch: "light",
            title: "Build a shelter",
            help: "Hold planks, stone or soil and place blocks with the right button: walls and a roof.",
            needs: ["fire"],
            objectives: [
                (kind: place, what: "any", count: 20, label: "blocks"),
            ],
            unlocks: ["torch"],
        ),
        (
            id: "torch",
            branch: "light",
            title: "Light the night",
            help: "Set torches round your shelter and stay by them as night falls.",
            needs: ["build"],
            objectives: [
                (kind: craft, what: "recipe:torch", count: 2, label: "make"),
                (kind: place, what: "block:torch", count: 4, label: "place"),
                (kind: night, what: "light", count: 1, label: "nightfall"),
            ],
        ),
        // ---- 7. Getting about.
        (
            id: "map",
            branch: "about",
            title: "Read the map",
            help: "Open the map (M), and walk 200 m from where you read it.",
            needs: ["go-fishing"],
            objectives: [
                (kind: open, what: "map", count: 1, label: "open the map"),
                (kind: reach, what: "marked", count: 1, label: "walk 200 m"),
            ],
        ),
        (
            id: "swim",
            branch: "about",
            title: "Into the water",
            help: "Walk into deep water and swim.",
            needs: ["map"],
            objectives: [
                (kind: swim, what: "water", count: 20, label: "metres"),
            ],
        ),
        (
            id: "reef",
            branch: "about",
            title: "See a reef",
            help: "Swim down where the sea is warm and shallow.",
            needs: ["swim"],
            objectives: [
                (kind: reach, what: "reef", count: 1, label: "reef"),
            ],
        ),
        (
            id: "town",
            branch: "about",
            title: "Find a town",
            help: "Towns show on the map; follow the compass to one.",
            needs: ["reef"],
            objectives: [
                (kind: reach, what: "town", count: 1, label: "town"),
            ],
        ),
        (
            id: "boat",
            branch: "about",
            title: "Take a boat",
            help: "Board a rowboat or a cog at a town's quay (E) and head out.",
            needs: ["town"],
            objectives: [
                (kind: board, what: "boat", count: 1, label: "board"),
                (kind: travel, what: "boat", count: 100, label: "metres"),
            ],
        ),
    ],
)
