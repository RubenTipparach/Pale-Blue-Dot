        // ---- 7. Getting about.
        (
            id: "map",
            branch: "about",
            icon: "missions/map",
            needs: ["go-fishing"],
            objectives: [
                (kind: open, what: "map", count: 1),
                (kind: reach, what: "marked", count: 1),
            ],
        ),
        (
            id: "swim",
            branch: "about",
            icon: "water_life/sea_otter",
            needs: ["map"],
            objectives: [
                (kind: swim, what: "water", count: 20),
            ],
        ),
        (
            id: "reef",
            branch: "about",
            icon: "fish/reef",
            needs: ["swim"],
            objectives: [
                (kind: gather, what: "block:reef rock", count: 1),
