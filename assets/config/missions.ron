        // ---- 6. Light and building.
        (
            id: "build",
            branch: "light",
            icon: "goods/stone",
            needs: ["fire"],
            objectives: [
                (kind: place, what: "any", count: 20),
            ],
            unlocks: ["torch"],
        ),
        (
            id: "torch",
            branch: "light",
            icon: "lights/torch",
            needs: ["build"],
            objectives: [
                (kind: craft, what: "recipe:torch", count: 2),
                (kind: place, what: "block:torch", count: 4),
                (kind: night, what: "light", count: 1),
            ],
