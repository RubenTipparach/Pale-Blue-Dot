// The water cap pass and the composite's underwater terms. Every field here is
// the code default written out (crates/pbd-app/src/config.rs); a test holds
// the two together. Omit a field to inherit the default; a zero is a zero.
// Units are in the Rust docs. Names follow Tenebris's water.yaml.
(
    time_scale: 0.75,
    depth_offset_m: 0.5,
    // The sea's surface (pbd_core::sea): the table the water cap draws and
    // the hulls float on. Wavelengths in metres, shortest first; the shortest
    // must be at least filter_spacings x the cap's 1.64 m vertex spacing.
    sea: (
        wavelengths_m: (7.0, 14.0, 28.0, 56.0, 112.0),
        swell_wavelength_m: 70.0,
        swell_height_m: 0.34,
        max_steepness: 0.1,
        max_hs_m: None,
        depth_limit: 0.6,
        filter_spacings: 2.5,
        tangent_fade: (0.75, 0.9),
    ),
    ripple_scale: 1.5,
    ripple_speed: 1.0,
    wave_steepness: 0.45,
    slope_max: 0.7,
    refract_amount: 0.04,
    refract_max_uv: 0.03,
    max_path_m: 200.0,
    // The water is lit, not luminous (`water-lit`, after crab-breeze's
    // water-look): the deep sea a near-black navy that the sky it mirrors
    // colours, teal shallows easing to it over 14 m of water, and clear
    // water (Pope and Fry, blue-green halved after Lee 2015).
    absorption_per_m: (0.32, 0.035, 0.012),
    // Light under water (`ocean-environments` design B2-B5). Absorption is
    // the view's path; downwelling is the daylight arriving at a depth, so
    // blue keeps 15% at 40 m (sunlit above) and 1.7% at 90 m (midnight
    // below), and the deep goes dark inside the column.
    downwell_per_m: (0.40, 0.065, 0.046),
    // Per metre toward the water's own colour; coast, ocean and river are
    // read today, the rest wait for the environment function (6.1).
    turbidity: (
        ocean: 0.022,
        coast: 0.07,
        river: 0.12,
        reef: 0.016,
        kelp: 0.05,
        polar: 0.03,
        marsh: 0.35,
        ease_s: 2.0,
    ),
    caustics: 3.0,
    caustic_cell_m: 4.0,
    caustic_fade_m: 30.0,
    shafts: 0.6,
    shaft_reach_m: 40.0,
    snow: 1.0,
    snow_from_m: 15.0,
    snow_glow: 0.006,
    spray_from_mps: 17.0,
    spray: 0.6,
    deep_color: (0.004, 0.018, 0.040),
    shallow_color: (0.020, 0.090, 0.075),
    shallow_depth_m: 14.0,
    sky_horizon_strength: 0.7,
    foam_crest_lo: 0.35,
    foam_crest_hi: 0.60,
    foam_crest_weight: 0.55,
    foam_slope_lo: 0.50,
    foam_slope_hi: 1.20,
    foam_slope_weight: 0.26,
    foam_intensity: 0.10,
    foam_color: (0.95, 0.97, 1.00),
    specular_intensity: 0.06,
    specular_power: 140.0,
    sun_tint: (1.10, 1.15, 1.20),
    fog_max: 0.82,
    rain_ripple_scale: 3.0,
    rain_ripple_strength: 6.0,
    underwater_distortion: 0.0015,
    wet_blur: 0.02,
    partial_band_m: 0.8,
    emerge_dry_s: 2.6,
    flow_uv_speed_falling: 1.0,
    // The tide's range at one place over a day, m, from the moon
    // (`ocean-environments` design 10). 0 is no tide.
    tide_range_m: 3.0,
    detail_fade: 4.0,
)
