// The water cap pass and the composite's underwater terms. Every field here is
// the code default written out (crates/pbd-app/src/config.rs); a test holds
// the two together. Omit a field to inherit the default; a zero is a zero.
// Units are in the Rust docs. Names follow Tenebris's water.yaml.
(
    time_scale: 0.75,
    depth_offset_m: 0.5,
    // The sea's surface (pbd_core::sea): the table the water cap draws and
    // the hulls float on. Wavelengths in metres, shortest first; the shortest
    // must be at least filter_spacings x the cap's 1.64 m vertex spacing.
    sea: (
        wavelengths_m: (7.0, 14.0, 28.0, 56.0, 112.0),
        swell_wavelength_m: 70.0,
        swell_height_m: 0.34,
        max_steepness: 0.1,
        max_hs_m: None,
        depth_limit: 0.6,
        filter_spacings: 2.5,
        tangent_fade: (0.75, 0.9),
    ),
    ripple_scale: 1.5,
    ripple_speed: 1.0,
    wave_steepness: 0.45,
    slope_max: 0.7,
    refract_amount: 0.04,
    refract_max_uv: 0.03,
    max_path_m: 200.0,
    // The water is lit, not luminous (`water-lit`, after crab-breeze's
    // water-look): the deep sea a near-black navy that the sky it mirrors
    // colours, teal shallows easing to it over 14 m of water, and clear
    // water (Pope and Fry, blue-green halved after Lee 2015).
    absorption_per_m: (0.32, 0.035, 0.012),
    // Light under water (`ocean-environments` design B2-B5). Absorption is
    // the view's path; downwelling is the daylight arriving at a depth, so
    // blue keeps 15% at 40 m (sunlit above) and 1.7% at 90 m (midnight
    // below), and the deep goes dark inside the column.
    downwell_per_m: (0.40, 0.065, 0.046),
    // Per metre toward the water's own colour; coast, ocean and river are
    // read today, the rest wait for the environment function (6.1).
    turbidity: (
        ocean: 0.022,
        coast: 0.07,
        river: 0.12,
        reef: 0.016,
        kelp: 0.05,
        polar: 0.03,
        marsh: 0.35,
        ease_s: 2.0,
    ),
    caustics: 3.0,
    caustic_cell_m: 4.0,
    caustic_fade_m: 30.0,
    shafts: 0.6,
    shaft_reach_m: 40.0,
    snow: 1.0,
    snow_from_m: 15.0,
    snow_glow: 0.006,
    spray_from_mps: 17.0,
    spray: 0.6,
    deep_color: (0.004, 0.018, 0.040),
    shallow_color: (0.020, 0.090, 0.075),
    shallow_depth_m: 14.0,
    sky_horizon_strength: 0.7,
    foam_crest_lo: 0.35,
    foam_crest_hi: 0.60,
    foam_crest_weight: 0.55,
    foam_slope_lo: 0.50,
    foam_slope_hi: 1.20,
    foam_slope_weight: 0.26,
    foam_intensity: 0.10,
    foam_color: (0.95, 0.97, 1.00),
    specular_intensity: 0.06,
    specular_power: 140.0,
    sun_tint: (1.10, 1.15, 1.20),
    fog_max: 0.82,
    rain_ripple_scale: 3.0,
    rain_ripple_strength: 6.0,
    underwater_distortion: 0.0015,
    wet_blur: 0.02,
    partial_band_m: 0.8,
    emerge_dry_s: 2.6,
    flow_uv_speed_falling: 1.0,
    detail_fade: 4.0,
    // A fall's look (`water-flow` 6.6): mockup M35's New tab, approved by the
    // owner 2026-11-16, with its defaults. Sizes and reaches in metres.
    falls: (
        rule: Proposed,
        smooth: true,
        mist_opacity: 2.0,
        mist_amount: 1.0,
        mist_size: 1.65,
        wall_blend_m: 1.2,
        droplets: 1.0,
        bubbles: 1.0,
        teal_churn: 1.0,
        aer_color: (0.16, 0.50, 0.46),
        fall_speed_up: 2.0,
        fall_speed_max_mps: 8.0,
        ripple_height: 0.5,
        ripple_length_m: 0.9,
        ripple_reach_m: 6.0,
        // Ripples need depth (owner, 2026-11-17: "this water is too shallow
        // for ripples"): none over a pool 1 m deep or less (one layer; the
        // landing cell under a fall is drawn full), full from 2 m, m.
        ripple_depth_none_m: 1.0,
        ripple_depth_full_m: 2.0,
        // The mist scales with the fall (owner, 2026-11-17: "the mist should
        // be 50% at this size"): puff opacity 0.5 at a drop D of 1.5 m or
        // less, the approved look from 4 m, m.
        mist_small_scale: 0.5,
        // And fewer particles there (owner, 2026-11-17: "less particles for
        // these shallow drops too"): puffs, spray, fall droplets and bubbles
        // at 35% of the approved count on a small fall, by the same ramp.
        particles_small_scale: 0.35,
        // No mist at all under a one-layer drop (owner, 2026-11-17: "no
        // steam/mist at all for drops that are less than 1 block height"),
        // m; a fall crossing it fades its mist over splash_fade_s.
        mist_none_below_m: 1.0,
        mist_small_drop_m: 1.5,
        mist_full_drop_m: 4.0,
        pool_flow: 0.1,
        pool_flow_reach_m: 6.0,
        glassy: true,
        glass_top_m: 0.70,
        glass_face_m: 0.50,
        froth_fill_m: 2.25,
        glass_tint: 0.25,
        edge_highlight: 0.0,
        splash_reach_m: 140.0,
        splash_fade_s: 0.6,
    ),
)
