// Decorative ground clutter: grass tufts, flowers, pebbles, leafy bushes and
// dead shrubs, drawn from the cell record in the vertex shader. Every density
// and size is Tenebris's shipped `scatter.yaml` value, because the cell is the
// same size on both sides (2.833 m flat-to-flat, 1 m tall) and a density per
// tile therefore carries over unchanged.
//
// An omitted field inherits the code default in `config.rs`; a present zero is
// zero, so `grass_chance: 0.0` turns the grass off rather than restoring it.
// A misspelled field is a startup error, not a knob that quietly does nothing.
//
// The two numbers that are OURS rather than the reference's are the first two.
// Tenebris meshes its scatter over the whole of a 300 m planet; this body is
// 4,800 m, so the clutter needs a reach. At the capture's field of view a
// 0.17 m blade is 26 pixels wide at 5 m, 3.3 at 40, 2.2 at 60 and 1.1 at 120,
// so past about 60 m a blade is sub-pixel shimmer that still costs a vertex.
// The cost says the same thing: 1,269 grassy cells inside 60 m against 31,729
// inside the 300 m finest band. The approved M13 mockup doubles each plant
// ring as the default (owner, 2026-11-15: "2x each LOD level distance";
// flora-v2 design 9.3), so the reach is 120 m and its fade 30 m: about four
// times the cells. Frame cost not measured yet.
(
    clutter_radius_m: 120.0,
    clutter_fade_m: 30.0,
    // Trees reach 1200 m (the finest band); over this last stretch, metres,
    // they dither out rather than popping (detail-fade). 0 is the hard line.
    tree_fade_m: 150.0,
    // Seconds new ground detail takes to dissolve in over the old when a new
    // fine set lands, rather than switching in one frame (detail-fade).
    lod_fade_s: 1.0,
    // Seconds a piece taken by hand (a pebble, a bush) sinks into the ground,
    // and rises again when it grows back (gather-by-hand).
    taken_sink_s: 0.25,
    // The share of each fine band, inward from its edge, across which the two
    // detail levels cross-fade with distance through complementary dither
    // masks, as Unity's LOD cross-fade does (distance-lod-fade). 0 is hard.
    lod_fade_width: 0.3,

    grass_chance: 0.8,
    grass_blades: 18.0,
    grass_height_m: 0.55,
    grass_blade_w_m: 0.085,
    grass_base_shade: 0.55,

    flower_chance: 0.12,
    flower_height_m: 0.32,

    rock_chance: 0.1,
    rock_size_m: 0.16,

    bush_chance: 0.05,
    bush_size_m: 0.34,

    shrub_chance: 0.14,
    shrub_size_m: 0.38,

    // flora-v2. The pixel tufts that take the grass slots when the player's
    // Pixel grass is on (at most 18, the slots), and their card in metres.
    tuft_count: 6.0,
    tuft_width_m: 0.8,
    tuft_height_m: 0.6,
    // Mushrooms and ferns on grassy cells, before each biome's weight
    // (pbd_core::flora::BIOME_FLORA).
    mushroom_chance: 0.05,
    fern_chance: 0.08,

    // flora-v2 design 9.4: fallen leaves in deciduous biomes, at the height
    // of autumn (0..1), how much thicker under a tree (0..1), and a leaf's
    // size against the mockup's (0.5..2).
    leaf_fall: 0.45,
    leaf_under: 0.7,
    leaf_size: 1.0,
    // flora-v2 design 9.6: the share of a fruiting biome's trees that bear.
    fruit_chance: 0.5,
    // flora-v2 design 10.4: the detailed trees' rings, the approved M13
    // mockup's doubled near and mid (metres). The near model to tree_near_m
    // (10..60), the mid cards to tree_mid_m, the far billboard past it; each
    // cross-fades over the last 0.3 of its ring (the mockup's fade width).
    tree_near_m: 44.0,
    tree_mid_m: 90.0,
    // flora-v2 design 13.3 (owner, 2026-11-16: "dithering should either stay
    // or go, dont have it linger if the player isnt moving"): a tree crossing
    // a ring fades over this many seconds and is then whole; a still camera
    // sees no dithered tree. The fade is shortened so the point the rings
    // are decided at never trails the camera by more than the lag, metres.
    tree_fade_s: 0.5,
    tree_fade_lag_m: 5.0,
    // tree-impostor-depth: how much of the near model's relief (its baked
    // normals and root-to-tip AO) the far trees take, 0..1. Zero is the flat
    // card: one normal and the crown's mean shade.
    tree_impostor_relief: 1.0,
)
