// What lives in the water (pbd_core::fauna): the water classes' depth limits,
// how schools move and spawn, how the rod works, and every body's species.
// The code defaults written out; a test holds the two together. Metres,
// seconds and degrees C unless a name says otherwise. The doc comments in
// crates/pbd-core/src/fauna/mod.rs say what each field is.
//
// A body's species are in roster order and the order is APPEND ONLY: a
// caught fish is saved as its index. No species may appear on two bodies,
// and a body with none has no fish. Why each species lives where it does is
// openspec/changes/fishing-and-equipment/design.md section 7, and the range
// each rule gives on the real planet is docs/wiki/fish-ranges/.
(
    water: (
        shallows_max_m: 6.0,
        shelf_max_m: 40.0,
        freezes_c: -1.8,
    ),
    flock: (
        separation: 2.6,
        alignment: 1.0,
        cohesion: 0.7,
        goal: 0.45,
        lured: 1.4,
        lure: 3.0,
        wall: 6.0,
        separation_m: 0.55,
        neighbour_m: 2.2,
        goal_every_s: (6.0, 12.0),
        goal_reach_m: 25.0,
        splash_m: 4.0,
        splash_push: 12.0,
        spook_s: 2.0,
        // fish-behaviour (M37) design 2 and 4: a swim turns at most this
        // fast, deg/s; each fish bursts and glides on a cycle of its own
        // (s, burst share, glide drag 1/s) and wanders this far in depth, m.
        turn_deg_s: 220.0,
        burst_s: 1.8,
        burst_share: 0.35,
        glide_drag_per_s: 0.9,
        depth_wander_m: 0.18,
        // The fish that leaves its school for a lure comes in at this share
        // of its cruising speed, slowing inside slow_m, to its mouth
        // standoff_m off the lure, its middle at most standoff_max_m off
        // (inside fishing.nibble_m).
        approach: 0.75,
        slow_m: 1.3,
        standoff_m: 0.15,
        standoff_max_m: 0.36,
    ),
    spawn: (
        ring_m: (20.0, 60.0),
        despawn_m: 90.0,
        attempts_per_s: 4.0,
        max_schools: 8,
        max_life: 6,
        step_hz: 30.0,
    ),
    fishing: (
        charge_s: 1.2,
        speed_mps: (5.0, 18.0),
        lift_mps: (3.0, 6.0),
        flight_max_s: 5.0,
        line_max_m: 45.0,
        splash_s: 1.2,
        scent_every_s: 0.5,
        scent_reach: 3.0,
        bite_chance: 0.175,
        nibble_m: 0.45,
        nibbles: (1, 3),
        nibble_s: (0.6, 1.4),
        hook_window_s: 0.9,
        hook_step: 0.13,
        hook_floor_s: 0.25,
        bite_dip_m: 0.14,
        nibble_dip_m: 0.035,
        reel_mps: 1.8,
        tension_base: 0.35,
        tension_pull: 0.8,
        tension_fall: 0.7,
        stamina_drain: 0.08,
        stamina_floor: 0.15,
        land_line_m: 1.3,
        land_depth_m: 0.15,
        cover_bite: 0.35,
        rain_bite: 0.7,
        rain_full_mm_h: 5.0,
        // A cast with bait in the pack: the bite factor times 1 + this
        // (`starter-missions` G1).
        bait_bite: 0.5,
    ),
    // How a fish is drawn moving (fish-behaviour, M37's Proposed sliders):
    // degrees, seconds, metres, Hz; a wave's lengths are body lengths.
    behaviour: (
        pose: (
            turn_deg_s: 260.0,
            heading_ease_s: 0.12,
            pitch_max_deg: 35.0,
            bank_at_90_deg: 14.0,
            bank_max_deg: 28.0,
            roll_ease_s: 0.18,
        ),
        lure: (
            standoff_m: 0.15,
            hover_drift_m: 0.03,
            drift_period_s: 2.6,
            dart_s: 0.14,
            back_off_s: 0.35,
            shake_deg: 12.0,
            shake_hz: 7.0,
            tug_m: 0.02,
            circle_chance: 0.6,
            circle_m: 0.2,
            take_dart_s: 0.08,
            take_turn_deg_s: 520.0,
            take_mps: 1.4,
            take_dive_deg: 22.0,
            take_reach_m: 0.3,
            bolt_speed: 1.6,
            bolt_s: 1.2,
        ),
        fight: (
            turn_deg_s: 300.0,
            ease_s: 0.22,
            accel_deg_s2: 1200.0,
            fade_s: 0.35,
            shake_deg: 18.0,
            shake_hz: 3.5,
            flash_deg: 30.0,
            run_dive_deg: 14.0,
        ),
        // The body wave: carangiform (perch), anguilliform (eel), a ray's wings.
        fish_wave: (
            beat_rest_hz: 0.5,
            beat_per_len_hz: 1.0,
            hover_hz: 1.2,
            beat_max_hz: 8.0,
            amp_cruise: 0.075,
            amp_burst: 0.11,
            amp_hover: 0.025,
            amp_glide: 0.004,
            amp_ease_s: 0.18,
            head: 0.04,
            expo: 2.0,
            waves: 0.95,
            recoil: 0.35,
            recoil_reach: 0.4,
            bend_at_90: 0.06,
            bend_max: 0.14,
            bend_ease_s: 0.15,
            glide_len_s2: 0.35,
            hover_len_s: 0.4,
            wing_expo: 1.6,
            wing_waves: 0.7,
            flap: 0.0,
            whip: 0.05,
        ),
        eel_wave: (
            beat_rest_hz: 0.4,
            beat_per_len_hz: 1.0,
            hover_hz: 0.7,
            beat_max_hz: 4.0,
            amp_cruise: 0.07,
            amp_burst: 0.09,
            amp_hover: 0.03,
            amp_glide: 0.01,
            amp_ease_s: 0.25,
            head: 0.3,
            expo: 0.8,
            waves: 1.25,
            recoil: 0.0,
            recoil_reach: 0.3,
            bend_at_90: 0.1,
            bend_max: 0.22,
            bend_ease_s: 0.2,
            glide_len_s2: 0.3,
            hover_len_s: 0.3,
            wing_expo: 1.6,
            wing_waves: 0.7,
            flap: 0.0,
            whip: 0.05,
        ),
        ray_wave: (
            beat_rest_hz: 0.4,
            beat_per_len_hz: 0.6,
            hover_hz: 0.6,
            beat_max_hz: 3.0,
            amp_cruise: 0.08,
            amp_burst: 0.12,
            amp_hover: 0.03,
            amp_glide: 0.006,
            amp_ease_s: 0.25,
            head: 0.0,
            expo: 1.0,
            waves: 1.0,
            recoil: 0.0,
            recoil_reach: 0.3,
            bend_at_90: 0.04,
            bend_max: 0.1,
            bend_ease_s: 0.2,
            glide_len_s2: 0.3,
            hover_len_s: 0.3,
            wing_expo: 1.6,
            wing_waves: 0.7,
            flap: 0.0,
            whip: 0.05,
        ),
    ),
    bodies: {
        "home": [
            (
                id: "minnow",
                name: "Minnow",
                from: Tenebris("Fish"),
                class: Fish,
