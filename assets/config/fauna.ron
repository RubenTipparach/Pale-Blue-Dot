// What lives in the water (pbd_core::fauna): the water classes' depth limits,
// how schools move and spawn, how the rod works, and every body's species.
// The code defaults written out; a test holds the two together. Metres,
// seconds and degrees C unless a name says otherwise. The doc comments in
// crates/pbd-core/src/fauna/mod.rs say what each field is.
//
// A body's species are in roster order and the order is APPEND ONLY: a
// caught fish is saved as its index. No species may appear on two bodies,
// and a body with none has no fish. Why each species lives where it does is
// openspec/changes/fishing-and-equipment/design.md section 7, and the range
// each rule gives on the real planet is docs/wiki/fish-ranges/.
(
    water: (
        shallows_max_m: 6.0,
        shelf_max_m: 40.0,
        freezes_c: -1.8,
    ),
    flock: (
        separation: 2.6,
        alignment: 1.0,
        cohesion: 0.7,
        goal: 0.45,
        lured: 1.4,
        lure: 3.0,
        wall: 6.0,
        separation_m: 0.55,
        neighbour_m: 2.2,
        goal_every_s: (6.0, 12.0),
        goal_reach_m: 25.0,
        splash_m: 4.0,
        splash_push: 12.0,
        spook_s: 2.0,
    ),
    spawn: (
        ring_m: (20.0, 60.0),
        despawn_m: 90.0,
        attempts_per_s: 4.0,
        max_schools: 8,
        step_hz: 30.0,
    ),
    fishing: (
        charge_s: 1.2,
        speed_mps: (5.0, 18.0),
        lift_mps: (3.0, 6.0),
        flight_max_s: 5.0,
        line_max_m: 45.0,
        splash_s: 1.2,
        scent_every_s: 0.5,
        scent_reach: 3.0,
        bite_chance: 0.175,
        nibble_m: 0.45,
        nibbles: (1, 3),
        nibble_s: (0.6, 1.4),
        hook_window_s: 0.9,
        hook_step: 0.13,
        hook_floor_s: 0.25,
        bite_dip_m: 0.14,
        nibble_dip_m: 0.035,
        reel_mps: 1.8,
        tension_base: 0.35,
        tension_pull: 0.8,
        tension_fall: 0.7,
        stamina_drain: 0.08,
        stamina_floor: 0.15,
        land_line_m: 1.3,
        land_depth_m: 0.15,
        cover_bite: 0.35,
        rain_bite: 0.7,
        rain_full_mm_h: 5.0,
    ),
    bodies: {
        "home": [
            (
                id: "minnow",
                name: "Minnow",
                from: Tenebris("Fish"),
                water: [
                    River,
                    Shallows,
                ],
                temp_c: (10.0, 30.0),
                length_m: 0.14,
                speed_mps: (1.0, 2.6),
                depth_m: (0.3, 1.8),
                bed: false,
                school: (24, 36),
                max_schools: 2,
                sense_m: 8.0,
                bite: 0.6,
                pull: 0.4,
                strength: 1,
                colour: (0.47, 0.59, 0.71),
                shape: (0.5, 0.5, 1.0),
                icon: "fish/minnow",
                guide: (
                    entry: "The first fish most anglers land. Minnows crowd the shallows and river mouths in schools of thirty or more and turn as one when a shadow crosses them. They bite quickly and give up easily.",
                    tip: "Cast anywhere near a warm shore. A school finds the lure in seconds.",
                ),
            ),
            (
                id: "silverfin",
                name: "Silverfin",
                from: New,
                water: [
                    Shallows,
                    Shelf,
                ],
                temp_c: (-1.8, 17.0),
                length_m: 0.22,
                speed_mps: (1.2, 3.2),
                depth_m: (0.4, 2.5),
                bed: false,
                school: (18, 30),
                max_schools: 2,
                sense_m: 7.0,
                bite: 0.55,
                pull: 0.55,
                strength: 1,
                colour: (0.81, 0.89, 0.92),
                shape: (0.5, 0.5, 1.0),
                icon: "fish/silverfin",
                guide: (
                    entry: "A bright, fast surface fish of cool coasts, from the edge of the ice to water as warm as 17 degrees. Silverfin skim the top two metres and scatter at a splash, then close ranks again a few seconds later.",
                    tip: "Let the splash settle before you expect a bite.",
                ),
            ),
            (
                id: "perch",
                name: "Banded perch",
                from: New,
                water: [
                    River,
                ],
                temp_c: (-1.8, 24.0),
                length_m: 0.38,
                speed_mps: (0.8, 2.4),
                depth_m: (0.5, 2.0),
                bed: false,
                school: (8, 14),
                max_schools: 2,
                sense_m: 9.0,
                bite: 0.4,
                pull: 0.85,
                strength: 2,
                colour: (0.85, 0.63, 0.23),
                shape: (0.55, 0.62, 1.0),
                icon: "fish/perch",
                guide: (
                    entry: "Striped, deep-bodied and curious. Perch hold the river channels in loose groups of a dozen, in any river that does not freeze, and one will follow a lure a long way before it commits.",
                    tip: "Nibbles come in threes. Wait for the float to go under.",
                ),
            ),
            (
                id: "ray",
                name: "Ray",
                from: Tenebris("FlatFish"),
                water: [
                    Shallows,
                    Shelf,
                ],
                temp_c: (16.0, 32.0),
                length_m: 0.6,
                speed_mps: (0.5, 1.2),
                depth_m: (1.5, 40.0),
                bed: true,
                school: (1, 2),
                max_schools: 1,
                sense_m: 10.0,
                bite: 0.35,
                pull: 0.9,
                strength: 2,
                colour: (0.73, 0.65, 0.49),
                shape: (1.7, 0.22, 0.8),
                icon: "fish/ray",
                guide: (
                    entry: "A flat grazer that lies on the sand and lifts off in slow wingbeats. Rays travel alone or in pairs along the bed of warm shallows and shelf, well out from the beach.",
                    tip: "Cast long, over sand. A ray never schools, so a bite is one fish, not one of many.",
                ),
            ),
            (
                id: "eel",
                name: "Eel",
                from: Tenebris("LongFish"),
                water: [
                    River,
                    Shallows,
                ],
                temp_c: (6.0, 28.0),
                length_m: 0.9,
                speed_mps: (0.7, 1.9),
                depth_m: (1.0, 6.0),
                bed: true,
                school: (1, 2),
                max_schools: 1,
                sense_m: 9.0,
                bite: 0.3,
                pull: 1.1,
                strength: 3,
                colour: (0.47, 0.51, 0.28),
                shape: (0.28, 0.28, 1.8),
                icon: "fish/eel",
                guide: (
                    entry: "Long, dark and patient. Eels keep to the bed of rivers and shallows in ones and twos and fight in hard, twisting runs.",
                    tip: "Ease off whenever it runs. More lines are lost to eels than to anything else.",
                ),
            ),
            (
                id: "reef",
                name: "Reef fish",
                from: Tenebris("LargeFish"),
                water: [
                    Shallows,
                ],
                temp_c: (23.0, 32.0),
                length_m: 0.42,
                speed_mps: (0.6, 1.6),
                depth_m: (0.8, 3.0),
                bed: false,
                school: (6, 12),
                max_schools: 1,
                sense_m: 8.0,
                bite: 0.25,
                pull: 1.2,
                strength: 5,
                colour: (0.24, 0.59, 0.59),
                shape: (0.5, 0.8, 1.0),
                icon: "fish/reef",
                guide: (
                    entry: "The prize of warm water. Tall-finned and nervous, reef fish shoal in small groups over tropical shallows that never fall below 23 degrees, and give the shortest bite window of anything in the sea.",
                    tip: "The hook window is under half a second. Watch the float, not the fish.",
                ),
            ),
            (
                id: "deepback",
                name: "Deepback",
                from: New,
                water: [
                    Shelf,
                    Deep,
                ],
                temp_c: (-1.5, 9.0),
                length_m: 0.7,
                speed_mps: (0.6, 1.8),
                depth_m: (2.5, 6.0),
                bed: false,
                school: (4, 7),
                max_schools: 1,
                sense_m: 12.0,
                bite: 0.22,
                pull: 1.35,
                strength: 4,
                colour: (0.31, 0.44, 0.56),
                shape: (0.55, 0.55, 1.0),
                icon: "fish/deepback",
                guide: (
                    entry: "A heavy cold-water fish of the shelf and the deep. Small schools cruise below two and a half metres, and a hooked deepback runs long and tires slowly.",
                    tip: "Fish where the shelf drops close to the shore, where the water turns dark.",
                ),
            ),
            (
                id: "serpent",
                name: "Sea serpent",
                from: Tenebris("SerpentFish"),
                water: [
                    Deep,
                ],
                temp_c: (-1.8, 32.0),
                length_m: 1.3,
                speed_mps: (0.8, 2.2),
                depth_m: (3.5, 6.0),
                bed: false,
                school: (1, 1),
                max_schools: 1,
                sense_m: 14.0,
                bite: 0.12,
                pull: 1.45,
                strength: 4,
                colour: (0.19, 0.47, 0.42),
                shape: (0.35, 0.4, 2.2),
                icon: "fish/serpent",
                guide: (
                    entry: "Rare and solitary, found only past the drop-off in any deep sea that does not freeze. A serpent seldom takes a lure and pulls like a boat. Every angler has a story about one that got away.",
                    tip: "There is at most one in any water. Deep water, a long cast and patience.",
                ),
            ),
        ],
    },
)
