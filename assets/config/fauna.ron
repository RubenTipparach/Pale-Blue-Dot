                bed: false,
                school: (18, 30),
                max_schools: 2,
                sense_m: 7.0,
                bite: 0.55,
                pull: 0.55,
                strength: 1,
                colour: (0.81, 0.89, 0.92),
                shape: (0.5, 0.5, 1.0),
                icon: "fish/silverfin",
                guide: (
                    entry: "A bright, fast surface fish of cool coasts, from the edge of the ice to water as warm as 17 degrees. Silverfin skim the top two meters and scatter at a splash, then close ranks again a few seconds later.",
                    tip: "Let the splash settle before you expect a bite.",
                ),
            ),
            (
                id: "perch",
