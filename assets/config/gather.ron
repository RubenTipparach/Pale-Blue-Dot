// Tier 0 off the ground (pbd_core::gather, `tool-crafting` decisions 2 and
// 3). A find is picked by the cell and layer, so a cell always answers the
// same, and a placed block turns up nothing.
//
// The code defaults written out; a test holds the two together.
(
    // Dug grass gives plant fibre in one cell in this many.
    fibre_one_in: 3,
    // Dug dirt, soil and sand give loose stone in one cell in this many.
    stone_one_in: 3,
    // The most logs a tree gives, to an axe or to hands (hands are slower).
    axe_logs: 4,
    // Earth gives bait worms in one cell in this many, anywhere (owner,
    // 2026-11-19: "1 in 5 dirt blocks have worm"). The water's reach below
    // is kept for the rule's tests and no longer gates bait.
    // Was: earth by the water gives bait worms in one cell in this many
    // (`starter-missions` G1, `dig-fixes` 2): grass, soil, dirt or sand,
    // where a river's or the sea's water stands within this many cells,
    bait_one_in: 5,
    bait_reach_cells: 3,
    // its layer this many metres from the dug one (the water's altitude
    // less the dug layer's), lowest first.
    bait_water_m: (-3.0, 2.0),
)
