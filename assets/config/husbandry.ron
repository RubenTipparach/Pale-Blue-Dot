// Keeping animals (pbd_core::husbandry; openspec/changes/animal-husbandry,
// design decision 12): taming, needs, wild herds, and every body's land
// species. This file is also the code's one source of defaults. Metres,
// seconds, world days (48 minutes of play) and trust out of 100 unless a
// name says otherwise. The doc comments in crates/pbd-core/src/husbandry/
// say what each field is.
//
// A body's land species are in roster order and the order is APPEND ONLY: a
// kept animal's record names its species by index. No species may appear on
// two bodies, nor share an id with a fish, and a body with none has no land
// life (every airless body).
(
    taming: (
        fear_moving_m: 9.0,
        fear_still_m: 4.5,
        reach_m: 2.5,
        spook_cost: 10.0,
        decay_per_hour: 5.0,
        follow_s: 60.0,
        // A wild animal fed from the hand follows this long (taming-hearts).
        wild_follow_s: 20.0,
    ),
    needs: (
        mood_per_need: 25.0,
        content_mood: 50.0,
        health_per_day: 10.0,
        sick_below: 30.0,
        stray_after_days: 5.0,
        hand_feed_days: 2.0,
        cap_days: 4.0,
    ),
    herds: (
        square_m: 160.0,
        chance: 0.35,
        spread_m: 9.0,
        near_m: 150.0,
        fade_s: 1.0,
    ),
    // Eggs, pairing and inheritance (design 13): mood and health out of
    // 100, the morning check as a fraction of the world day, a mutation one
    // allele in 32 by up to 0.15, hardiness lowered 0.5 x F, F read back
    // four generations and warned above first cousins (1/16). A carried
    // fertile egg goes cold after a day; an incubator holds 6 and wants a
    // lamp within 3 m.
    breeding: (
        mood_min: 60.0,
        health_min: 50.0,
        morning: 0.25,
        mutate_one_in: 32,
        mutate_step: 0.15,
        hardiness_per_f: 0.5,
        generations: 4,
        warn_f: 0.0625,
        cold_after_days: 1.0,
        incubator_eggs: 6,
        lamp_m: 3.0,
    ),
    land: {
        "home": [
            (
                id: "meadow-hen",
                class: Bird,
                status: Tameable,
                plan: Bird,
                herd: (4, 7),
                length_m: 0.42,
                height_m: 0.42,
                walk_mps: 0.6,
                run_mps: 3.0,
                stride_m: 0.16,
                colours: ((0.93, 0.89, 0.80), (0.80, 0.16, 0.12), (0.92, 0.70, 0.22), (0.95, 0.92, 0.85)),
                keep: Some((
                    // Grain (decision 3): seed and the ear (farming's wheat).
                    foods: [Good("wheat-seed"), Good("wheat")],
                    trust_gain: 34.0,
                    space_cells: 0.2,
                    grazing_cells: 0.2,
                    products: [
                        // An egg every 6 in-game hours while content (hen-laying, owner
                        // 2026-11-20).
                        (good: "egg", amount: 1.0, period_days: 0.25, sex: Some(F)),
                    ],
                    coats: ["cream", "russet", "black"],
                    patterns: ["plain", "speckled"],
                    morph: "golden",
                    adult_days: 10.0,
                    male_one_in: 6,
                    // Decision 8: a chick 0-5 days at 0.12 m of 0.42, a pullet
                    // 5-10 at 0.3 m; eggs hatch in 3 days, 8 under a broody hen.
                    young: (
                        stages: [
                            (name: "chick", until_days: 5.0, size: 0.29),
                            (name: "pullet", until_days: 10.0, size: 0.71),
                        ],
                        adult: ("hen", "cockerel"),
                        birth: Eggs(incubation_days: 3.0, clutch_max: 8),
                    ),
                )),
            ),
            (
                id: "woolback",
                class: Mammal,
                status: Tameable,
                plan: Quadruped,
                herd: (3, 6),
                length_m: 1.2,
                height_m: 0.8,
                walk_mps: 0.9,
                run_mps: 4.0,
                stride_m: 0.7,
                colours: ((0.90, 0.87, 0.78), (0.82, 0.78, 0.68), (0.20, 0.17, 0.15), (0.24, 0.20, 0.18)),
                keep: Some((
                    // Grain (decision 3), and the turf it grazes.
                    foods: [Good("wheat"), Turf],
                    trust_gain: 25.0,
                    space_cells: 1.0,
                    grazing_cells: 1.0,
                    products: [
                        (good: "wool", amount: 3.0, period_days: 4.0, sex: None),
                    ],
                    coats: ["cream", "grey", "black"],
                    patterns: ["plain", "piebald"],
                    morph: "melanic",
                    adult_days: 12.0,
                    male_one_in: 5,
                    // Decision 8: gestation 5, 1-2 lambs; lamb 0-6 at 45%, hogg 6-12 at 75%.
                    young: (
                        stages: [
                            (name: "lamb", until_days: 6.0, size: 0.45),
                            (name: "hogg", until_days: 12.0, size: 0.75),
                        ],
                        adult: ("ewe", "ram"),
                        birth: Live(gestation_days: 5.0, litter: (1, 2)),
                    ),
                )),
            ),
            (
                id: "plodder",
                class: Mammal,
                status: Tameable,
                plan: Quadruped,
                herd: (2, 4),
                length_m: 2.0,
                height_m: 1.35,
                walk_mps: 0.8,
                run_mps: 3.2,
                stride_m: 1.1,
                colours: ((0.52, 0.34, 0.20), (0.92, 0.88, 0.80), (0.30, 0.22, 0.16), (0.46, 0.30, 0.18)),
                keep: Some((
                    // Turnips (decision 3), and the turf it grazes.
                    foods: [Good("turnip"), Turf],
                    trust_gain: 20.0,
                    space_cells: 2.0,
                    grazing_cells: 2.0,
                    products: [
                        (good: "milk", amount: 1.0, period_days: 1.0, sex: Some(F)),
                        // Its hide, tanned (small-boats design 2e; the owner:
                        // "cows and horses should" give leather).
                        (good: "leather", amount: 1.0, period_days: 6.0, sex: None),
                    ],
                    coats: ["brown", "red", "dun"],
                    patterns: ["plain", "belted"],
                    morph: "albino",
                    adult_days: 16.0,
                    male_one_in: 4,
                    // Decision 8: gestation 8, one calf; calf 0-8 at 40%, young 8-16 at 75%.
                    young: (
                        stages: [
                            (name: "calf", until_days: 8.0, size: 0.40),
                            (name: "young", until_days: 16.0, size: 0.75),
                        ],
                        adult: ("cow", "bull"),
                        birth: Live(gestation_days: 8.0, litter: (1, 1)),
                    ),
                )),
            ),
            // The horse (`land-transport` design 10): bought in town for the
            // horse cart's shafts, never wild, so no herd rolls it. Kept like
            // the herd on wheat, turnip and turf, and gives leather (the
            // owner: "cows and horses should").
            (
                id: "horse",
                class: Mammal,
                status: Bought,
                plan: Horse,
                herd: (1, 1),
                length_m: 2.3,
                height_m: 1.55,
                walk_mps: 1.5,
                run_mps: 6.0,
                stride_m: 1.7,
                colours: ((0.45, 0.28, 0.16), (0.62, 0.46, 0.32), (0.16, 0.11, 0.08), (0.40, 0.25, 0.15)),
                keep: Some((
                    foods: [Good("wheat"), Good("turnip"), Turf],
                    trust_gain: 34.0,
                    space_cells: 2.0,
                    grazing_cells: 2.0,
                    products: [
                        (good: "leather", amount: 1.0, period_days: 8.0, sex: None),
                    ],
                    coats: ["bay", "chestnut", "grey"],
                    patterns: ["plain", "blaze"],
                    morph: "dapple",
                    adult_days: 20.0,
                    male_one_in: 2,
                    young: (
                        stages: [
                            (name: "foal", until_days: 10.0, size: 0.5),
                            (name: "yearling", until_days: 20.0, size: 0.8),
                        ],
                        adult: ("mare", "stallion"),
                        birth: Live(gestation_days: 10.0, litter: (1, 1)),
                    ),
                )),
            ),
        ],
    },
)
