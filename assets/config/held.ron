// How the tool in hand moves (crates/pbd-app/src/held.rs). The tools' shapes,
// their held poses and the hand are not here: they are generated data,
// assets/models/held_tools.ron, written by tools/gen_held_tools.py from the
// approved Hex Tool Bench mockup (openspec/changes/hex-held-tools) and the
// hand of the approved Tools in Hand mockup (openspec/changes/hand-model).
//
// The idle sway (amplitude right and up, m, and rate, rad/s) is Tenebris's
// viewmodel's.
//
// `stroke` is the pickaxe's and the axe's stroke, windup, anticipation, hit
// and recoil on the shoulder arc, on one steady beat timed by the dig
// (openspec/changes/held-swing, decisions 5-8); `shovel` is the shovel's
// (decision 9: tip down, slide into the dirt, tip about the blade's point,
// pull up), its times the stroke's with scoop_s in place of recoil_s. The
// values are the Tools in Hand mockup's (M36 v8; the shovel's low shoulder,
// fist_drop_m and arm_follow, v12) as its Copy RON prints them. s, rad, m and deg as named; `shoulder` is eye space, m (x right, y
// up, -z ahead); `sleeve_extra` is tool units; the weights are ratios.
// camera_kick_rad stays 0: the game does not kick the camera.
//
// `punch` is the bare-hand punch and `swing` the stroke at the air and at a
// refused block, the hands' and the tools' (openspec/changes/held-swing,
// decisions 10-12; Tools in Hand version 16, approved for the game by the
// owner, 2026-11-21, as its Tune prints them). s, m and rad as named, eye
// space; the elbow is eye space, m; hands_weight, elbow_follow and
// air_recover_k are ratios; thud_shake_hz is Hz.
//
// `rod` is how the rod moves with the line (openspec/changes/rod-motion,
// design 2). Pitch is about the fist, tip up and back positive; each value
// is a size, rate or time and the code gives it its sign. rad, m, s and Hz
// as named; the spring's damping is a ratio (1 is critical). The rod's flex
// (flex, rad per rad/s, bend_*) and the follow-through while the float flies
// (follow_rad, and follow_reach, a share of the flick's reach) are
// rod-motion design 8.
//
// `hand_light` is the hand's shade (openspec/changes/hand-model):
// ambient + wrap * (0.5 + 0.5 n.l)^2 + fill * max(n.f, 0), the light and the
// fill fixed in eye space.
//
// `light` is a light held in hand (openspec/changes/glowing-mushrooms,
// design 14; the M13 v3 mockup's HOLD block): the nearest the carried light
// is taken to the hand, m (carried_hand_min_m); the torch's flicker, a
// share of its strength (a lantern a third of it); the flame sheet's frames
// a second and the flame's height, m; each hold's grip, eye space m, and the
// way the thing held runs from it; and the hold's sway (m a step, m, m, rad,
// m and 1/s).
//
// The code defaults written out; a test holds the two together.
(
    sway_m: (0.006, 0.005),
    sway_rate: (1.3, 1.7),
    stroke: (
        windup_s: 0.1,
        windup_rad: 0.35,
        raise_rad: 0.42,
        coil_m: 0.03,
        anticipate_s: 0.07,
        anticipate_rad: 0.08,
        strike_s: 0.06,
        strike_rad: 0.55,
        reach_rad: 0.05,
        extend_m: 0.12,
        sweep_rad: 0.25,
        impact_hold_s: 0.05,
        recoil_s: 0.06,
        recoil_rad: 0.15,
        follow_rad: 0.08,
        recover_s: 0.16,
        lag_s: 0.03,
        overlap_rad: 0.06,
        stroke_target_s: 0.45,
        camera_kick_rad: 0.0,
        exaggerate: 1.0,
        shoulder: (0.2, -0.25, 0.05),
        pickaxe_weight: 1.15,
        axe_weight: 1.1,
        shovel_weight: 0.85,
        tier_slow: 0.04,
        sleeve_extra: 6.0,
    ),
    shovel: (
        entry_deg: 6.0,
        slide_m: 0.28,
        slide_drop_m: 0.03,
        lever_rad: 0.5,
        lift_m: 0.14,
        pull_m: 0.05,
        scoop_s: 0.26,
        across_m: 0.0,
        arm_follow: 0.7,
        fist_drop_m: 0.16,
        fist_fwd_m: 0.12,
    ),
    punch: (
        windup_s: 0.09,
        draw_m: 0.08,
        drop_m: 0.0,
        cock_rad: 0.05,
        anticipate_s: 0.06,
        anticipate_m: 0.025,
        strike_s: 0.07,
        reach_m: 0.06,
        across_m: 0.19,
        rise_m: 0.13,
        twist_rad: 0.0,
        sweep_rad: 0.0,
        arc_m: 0.03,
        impact_hold_s: 0.04,
        recoil_s: 0.07,
        recoil_m: 0.06,
        recover_s: 0.16,
        hands_weight: 0.8,
        fist_raise_m: 0.1,
        fist_in_m: 0.12,
        guard_twist_rad: 0.0,
        guard_cock_rad: 0.0,
        hit_cock_rad: 0.0,
        bend_rad: 0.0,
        elbow_x: 0.37,
        elbow_y: -0.28,
        elbow_z: -0.25,
        elbow_follow: 0.75,
    ),
    swing: (
        air_follow_s: 0.1,
        air_follow_m: 0.07,
        air_follow_rad: 0.3,
        air_recover_k: 1.3,
        thud_hold_s: 0.07,
        thud_recoil_m: 0.05,
        thud_recoil_rad: 0.2,
        thud_shake_m: 0.008,
        thud_shake_hz: 22.0,
        thud_shake_s: 0.18,
    ),
    rod: (
        draw_rad: 0.9,
        cast_raise_m: 0.28,
        cast_back_m: 0.18,
        cast_reach_m: 0.07,
        flick_rad: 0.35,
        flick_s: 0.14,
        settle_rad: 0.12,
        bob_rad: 0.015,
        bob_hz: 0.4,
        nibble_rad: 0.05,
        nibble_s: 0.15,
        bite_rad: 0.22,
        bite_shake_rad: 0.04,
        bite_shake_hz: 14.0,
        fight_rad: 0.45,
        fight_shake_rad: 0.06,
        fight_shake_hz: 9.0,
        crank_m: 0.012,
        crank_hz: 3.0,
        roll_rad: 0.15,
        catch_rad: 0.6,
        catch_s: 0.6,
        ease_s: 0.3,
        spring_hz: 9.0,
        damping: 0.7,
        flex: 0.07,
        bend_max_rad: 0.6,
        bend_hz: 4.5,
        bend_damping: 0.3,
        follow_rad: 0.55,
        follow_reach: 0.8,
    ),
    hand_light: (
        ambient: 0.45,
        wrap: 0.55,
        fill: 0.12,
    ),
    light: (
        hand_min_m: 0.5,
        torch_flicker: 0.15,
        flame_fps: 11.0,
        flame_m: 0.19,
        torch: (grip: (0.24, -0.33, -0.52), up: (-0.12, 1.0, -0.35)),
        lantern: (grip: (0.25, -0.07, -0.62), up: (1.0, -0.05, 0.25)),
        mushroom: (grip: (0.22, -0.31, -0.46), up: (-0.15, 1.0, -0.5)),
        // No walking sway (owner, 2026-11-21: "howcome glow musshroom hand
        // is shaking when other hands arent", "no shaking hands when walk"):
        // the light hand keeps still as the tool hand does.
        sway: (
            step_m: 0.75,
            side_m: 0.0,
            bob_m: 0.0,
            roll_rad: 0.0,
            breathe_m: 0.003,
            ease_hz: 6.0,
        ),
    ),
    // A weapon in hand (`survival-mode` design 16): the held items' pose,
    // the torch's hold a little lower and further out, at rest with a
    // breath; its swings wait on their mockup (task 1.6).
    weapon: (
        hold: (grip: (0.26, -0.3, -0.56), up: (-0.18, 1.0, -0.42)),
        // A spear leant forward, its head ahead of the eye.
        spear_up: (-0.22, 0.62, -1.0),
        breathe_m: 0.003,
    ),
    // The weapons' swings (`survival-mode` combat C1, task 1.6), from the
    // drafted Weapons tab's In hand view (its RON button prints this block):
    // stage times s; keyed poses, the arm raised about the stroke's shoulder
    // (phi) and swung across (yaw, left positive), the fist pulled along the
    // aim (pull_m), the weapon's own pitch (tip up and back positive) and
    // roll. A melee swing's times are fitted to the rule's hit
    // (survival.ron); a thrown spear and the bow wait for the release.
    weapon_swing: (
        spear: (
            windup_s: 0.14, anticipate_s: 0.1, strike_s: 0.07,
            impact_hold_s: 0.05, recoil_s: 0.08, recover_s: 0.26,
            top: (phi: 0.04, yaw: 0.06, pull_m: -0.22, pitch: -0.58, roll: 0.0),
            coil: (phi: 0.06, yaw: 0.08, pull_m: -0.28, pitch: -0.62, roll: 0.0),
            hit: (phi: -0.05, yaw: -0.08, pull_m: 0.4, pitch: -0.74, roll: 0.0),
            recoil: (phi: -0.03, yaw: -0.05, pull_m: 0.3, pitch: -0.7, roll: 0.0),
        ),
        axe: (
            windup_s: 0.11, anticipate_s: 0.07, strike_s: 0.07,
            impact_hold_s: 0.05, recoil_s: 0.07, recover_s: 0.23,
            top: (phi: 0.55, yaw: -0.1, pull_m: -0.08, pitch: 0.95, roll: 0.1),
            coil: (phi: 0.62, yaw: -0.12, pull_m: -0.1, pitch: 1.08, roll: 0.12),
            hit: (phi: -0.3, yaw: 0.14, pull_m: 0.14, pitch: -1.45, roll: -0.05),
            recoil: (phi: -0.2, yaw: 0.1, pull_m: 0.1, pitch: -1.15, roll: 0.0),
        ),
        sword: (
            windup_s: 0.09, anticipate_s: 0.06, strike_s: 0.06,
            impact_hold_s: 0.03, recoil_s: 0.08, recover_s: 0.18,
            top: (phi: 0.4, yaw: -0.5, pull_m: -0.06, pitch: 0.55, roll: -0.85),
            coil: (phi: 0.46, yaw: -0.6, pull_m: -0.08, pitch: 0.65, roll: -0.95),
            hit: (phi: -0.05, yaw: 0.6, pull_m: 0.12, pitch: -0.75, roll: 0.7),
            recoil: (phi: -0.1, yaw: 0.75, pull_m: 0.08, pitch: -0.85, roll: 0.8),
        ),
        throw: (
            windup_s: 0.25, anticipate_s: 0.15, strike_s: 0.08,
            impact_hold_s: 0.0, recoil_s: 0.1, recover_s: 0.3,
            top: (phi: 0.42, yaw: -0.08, pull_m: -0.2, pitch: -0.5, roll: 0.0),
            coil: (phi: 0.46, yaw: -0.1, pull_m: -0.28, pitch: -0.52, roll: 0.0),
            hit: (phi: 0.12, yaw: 0.2, pull_m: 0.35, pitch: -0.72, roll: 0.0),
            recoil: (phi: -0.2, yaw: 0.28, pull_m: 0.2, pitch: -0.9, roll: 0.0),
        ),
        bow: (
            windup_s: 0.15, anticipate_s: 0.8, strike_s: 0.04,
            impact_hold_s: 0.02, recoil_s: 0.1, recover_s: 0.3,
            top: (phi: 0.12, yaw: 0.36, pull_m: 0.08, pitch: 0.32, roll: -0.12),
            coil: (phi: 0.14, yaw: 0.36, pull_m: 0.06, pitch: 0.32, roll: -0.12),
            hit: (phi: 0.15, yaw: 0.36, pull_m: 0.12, pitch: 0.34, roll: -0.12),
            recoil: (phi: 0.08, yaw: 0.34, pull_m: 0.06, pitch: 0.32, roll: -0.1),
        ),
        exaggerate: 1.0,
    ),
)
