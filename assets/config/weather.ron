// Rain and what it does to the lens, the ground and the air. Every field is
// the code default written out (crates/pbd-app/src/config.rs); a test holds
// the two together. Omit a field to inherit; a zero is a zero. Names follow
// Tenebris's weather.yaml and the values are its shipped ones.
(
    wet_fade_tau_s: 1.6,

    // The field: where and when it rains at all. A drifting field of warm
    // pockets condenses the terrain's own moisture into cloud; where the cloud
    // is thick enough it rains, and the rain trails the cloud by sampling the
    // same field `rain_min_s` earlier rather than by remembering anything. See
    // `pbd_core::weather`. Measured on the shipped values: the body averages
    // 0.18 cover with 5.9% of it precipitating at any moment.
    solar_scale: 2.2,
    solar_drift: 0.015,
    solar_floor: 0.55,
    arid_gamma: 1.35,
    cloud_min: 0.22,
    cloud_full: 0.52,
    min_alpha: 0.32,
    rain_cover_min: 0.62,
    rain_min_s: 15.0,
    // A weather system is far bigger than the 188 m a biome is decided on, so
    // moisture is asked a second question at its own planet-scale frequency.
    weather_moisture_scale: 1.6,
    rain_fall_mps: 70.0,
    rain_width_m: 0.012,
    rain_streak_m: 1.5,
    rain_color: (0.52, 0.62, 0.90),
    rain_alpha_near: 0.78,
    rain_alpha_far: 0.10,
    shower_radius_m: 18.0,
    shower_column_m: 46.0,
    shower_max_streaks: 1700,
    rain_lens_density: 1.4,
    rain_lens_refract: 1.7,
    rain_lens_speed: 1.0,
    rain_lens_size: 0.7,
    rain_ripple_scale: 5.0,
    rain_ripple_strength: 2.0,
    rain_flow_across: 128.0,
    rain_flow_down: 1.0,
    rain_flow_speed: 1.3,
    rain_flow_strength: -2.0,
    rain_wave_scale: 7.0,
    rain_wave_strength: 0.6,
    rain_wave_speed: 1.4,
    rain_wet_darken: 0.72,
    rain_sky_sheen: 0.8,
    rain_glint_power: 24.0,
    rain_glint_strength: 0.5,
)
