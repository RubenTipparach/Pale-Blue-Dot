// The phase-1 showcase, one file per branch of the mission tree
// (`step-videos` 5.2, `starter-missions` T.5): a bot plays the branch
// through the player's own inputs, each shot ending when its missions are
// done, or the run failing as stalled. Cooking, where the food comes from: the catch grilled and eaten, bread from the wheat, an egg fried.
//
// Each branch starts from the world the earlier ones left: run them in
// order on one `--world` (trunk, fishing, farming, herding, cooking, then
// mining, light and about). Nothing is set; every mission is played.
//
// The start is a level pasture with the sea within thirty metres (measured
// once: the only such place within 3 km of the fields spawn).
(
    goal: "Goal: cooking, from the catch, the field and the coop",
    at: Some((11.5085, -25.0992)),
    hour: 8.5,
    shots: [
        (
            caption: "Cooking. Grill the catch",
            until: ["cook-fish"],
            max_s: 150.0,
            acts: [Cook("grilled-fish", 2), Still],
        ),
        (
            caption: "Eat well",
            until: ["eat"],
            max_s: 30.0,
            acts: [Eat("grilled-fish"), Still],
        ),
        (
            caption: "Bake bread from the wheat",
            until: ["bread"],
            max_s: 150.0,
            acts: [Cook("flatbread", 2)],
        ),
        (
            caption: "Breakfast: an egg from the hen",
            until: ["fried-egg"],
            max_s: 120.0,
            acts: [Cook("fried-egg", 1), Still],
        ),
        (
            caption: "Cooking done",
            max_s: 20.0,
            acts: [Missions(6.0)],
        ),
    ],
)
