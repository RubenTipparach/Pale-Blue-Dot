// The town's furniture used as a player uses it, ahead of the carpentry
// branch's own pieces: a town seat sat on, a town store looted, a town bed
// lain on (`mission-playthrough` design 6, "sit", "find", "lie"). The logs
// say which piece took the bot, and what came out of the store.
(
    goal: "Goal: sit, loot and lie down in a town",
    at: None,
    hour: 10.0,
    shots: [
        (
            caption: "The night passes: morning in town",
            rate: Some(300.0),
            max_s: 120.0,
            acts: [Hour(9.0)],
        ),
        (
            caption: "Sit on a seat in town",
            max_s: 600.0,
            acts: [Seek("town"), Furniture("sit"), Still],
        ),
        (
            caption: "Look in a chest in town",
            max_s: 600.0,
            acts: [Furniture("loot"), Still],
        ),
        (
            caption: "Lie down on a bed",
            max_s: 600.0,
            acts: [Furniture("lie"), Still],
        ),
    ],
)
